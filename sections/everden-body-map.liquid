{%- comment -%}
  Body map: an image of a figure with labelled points. Each block is one point:
  x / y are the point's position on the image in percent; side puts the label left or right.
  Every label must cite a published study and say "found in", never "caused by".
{%- endcomment -%}
<style>
  .evbm{--bg:#1F1A16;--fg:#F6F2EB;--soft:#D9CFC2;--mute:#B4A595;--line:#8F7A66;--acc:#E9C9A4;--alarm:#E58A72;--serif:"Cormorant Garamond","Cormorant",Garamond,"Times New Roman",serif;background:var(--bg);color:var(--fg)}
  .evbm--cream{--bg:#F3E6D5;--fg:#1F1A16;--soft:#5E4C3E;--mute:#8A7B6D;--line:#B9A58F;--acc:#8A5A36;--alarm:#A3301F}
  .evbm--cream .evbm__label{color:#8A5A36}
  .evbm--cream .evbm__fig img{-webkit-mask-image:radial-gradient(ellipse 50% 50% at 50% 50%,#000 70%,transparent 100%);mask-image:radial-gradient(ellipse 50% 50% at 50% 50%,#000 70%,transparent 100%)}
  .evbm *{box-sizing:border-box}
  .evbm__wrap{max-width:1180px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,48px)}
  .evbm__head{max-width:660px;margin:0 auto clamp(28px,4vw,48px);text-align:center}
  .evbm__label{font-size:11px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;margin:0 0 16px;color:#C9B7A3}
  .evbm__h2{font-family:var(--serif);font-weight:500;font-size:clamp(30px,3.8vw,48px);line-height:1.08;margin:0 0 14px;text-wrap:balance}
  .evbm__intro{font-size:16px;line-height:1.7;color:var(--soft);margin:0}
  .evbm__stage{display:flex;justify-content:center}
  .evbm__fig{position:relative;width:min(100%,var(--w,420px))}
  .evbm__fig img{display:block;width:100%;height:auto}
  .evbm__dot{position:absolute;left:var(--x);top:var(--y);width:18px;height:18px;margin:-9px 0 0 -9px;border-radius:50%;background:var(--acc);border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.35)}
  .evbm__n{display:none}
  .evbm__pt{position:absolute;top:var(--ly);width:270px;transform:translateY(-18px)}
  .evbm__pt--l{right:calc(100% + 40px);text-align:right}
  .evbm__pt--r{left:calc(100% + 40px)}
  .evbm__svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}
  .evbm__svg line{stroke:var(--line);stroke-width:1.4;vector-effect:non-scaling-stroke}
  .evbm__svg line.halo{stroke:rgba(255,255,255,.85);stroke-width:4}
  .evbm__k{font-family:var(--serif);font-weight:700;font-size:34px;line-height:1;margin:0 0 4px;color:var(--alarm)}
  .evbm__t{font:700 12px/1.2 Inter,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;margin:0 0 6px;color:var(--fg)}
  .evbm__x{font-size:14.5px;line-height:1.5;color:var(--soft);margin:0}
  .evbm__s{font-size:12px;line-height:1.4;color:var(--mute);margin:6px 0 0}
  .evbm__s a{color:var(--acc);text-underline-offset:3px}
  .evbm__list{display:none}
  .evbm__note{max-width:760px;margin:clamp(28px,4vw,44px) auto 0;font-family:var(--serif);font-size:clamp(22px,2.4vw,26px);line-height:1.3;color:var(--fg);text-align:center;text-wrap:balance}
  .evbm__s{opacity:.8}
  @media (max-width:989px){
    .evbm__pt,.evbm__svg{display:none}
    .evbm__fig{width:min(78%,360px)}
    .evbm__dot{width:28px;height:28px;margin:-14px 0 0 -14px}
    .evbm__n{display:grid;place-items:center;width:100%;height:100%;font:700 13px/1 Inter,Arial,sans-serif;color:var(--bg)}
    .evbm__list{display:grid;gap:18px;list-style:none;margin:28px auto 0;padding:0;max-width:520px}
    .evbm__list li{display:grid;grid-template-columns:30px 1fr;gap:12px}
    .evbm__list .num{width:26px;height:26px;border-radius:50%;background:var(--acc);color:var(--bg);display:grid;place-items:center;font:700 13px/1 Inter,Arial,sans-serif;margin-top:3px}
    .evbm__k{font-size:30px}
  }
</style>
<div class="evbm evbm--{{ section.settings.scheme }}">
  <div class="evbm__wrap">
    <div class="evbm__head">
      {%- if section.settings.label != blank -%}<p class="evbm__label">{{ section.settings.label }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="evbm__h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="evbm__intro">{{ section.settings.intro }}</p>{%- endif -%}
    </div>
    <div class="evbm__stage">
      <div class="evbm__fig" style="--w:{{ section.settings.width }}px">
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(max-width: 989px) 78vw, 420px', alt: section.settings.image.alt | default: 'Illustration of a clear human figure with tiny plastic particles inside' }}
        {%- else -%}
          <div style="aspect-ratio:3/4;background:#2A231E"></div>
        {%- endif -%}
        {%- assign gap = 4000 | divided_by: section.settings.width -%}
        <svg class="evbm__svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {%- for block in section.blocks -%}
            {%- if block.settings.side == 'l' -%}{%- assign x1 = 0 | minus: gap -%}{%- else -%}{%- assign x1 = 100 | plus: gap -%}{%- endif -%}
            <line class="halo" x1="{{ x1 }}" y1="{{ block.settings.label_y }}" x2="{{ block.settings.x }}" y2="{{ block.settings.y }}"/><line x1="{{ x1 }}" y1="{{ block.settings.label_y }}" x2="{{ block.settings.x }}" y2="{{ block.settings.y }}"/>
          {%- endfor -%}
        </svg>
        {%- for block in section.blocks -%}
          {%- assign side = block.settings.side -%}
          <span class="evbm__dot" style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%"><span class="evbm__n">{{ forloop.index }}</span></span>
          <div class="evbm__pt evbm__pt--{{ side }}" style="--ly:{{ block.settings.label_y }}%" {{ block.shopify_attributes }}>
            {%- if block.settings.stat != blank -%}<p class="evbm__k">{{ block.settings.stat }}</p>{%- endif -%}
            <p class="evbm__t">{{ block.settings.title }}</p>
            <p class="evbm__x">{{ block.settings.text }}</p>
            {%- if block.settings.source != blank -%}<p class="evbm__s">{% if block.settings.url != blank %}<a href="{{ block.settings.url }}" target="_blank" rel="noopener">{{ block.settings.source }}</a>{% else %}{{ block.settings.source }}{% endif %}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
    <ol class="evbm__list">
      {%- for block in section.blocks -%}
        <li><span class="num">{{ forloop.index }}</span><div>
          {%- if block.settings.stat != blank -%}<p class="evbm__k">{{ block.settings.stat }}</p>{%- endif -%}
          <p class="evbm__t">{{ block.settings.title }}</p>
          <p class="evbm__x">{{ block.settings.text }}</p>
          {%- if block.settings.source != blank -%}<p class="evbm__s">{% if block.settings.url != blank %}<a href="{{ block.settings.url }}" target="_blank" rel="noopener">{{ block.settings.source }}</a>{% else %}{{ block.settings.source }}{% endif %}</p>{%- endif -%}
        </div></li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.note != blank -%}<p class="evbm__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Everden body map",
  "tag": "section",
  "class": "section section--full-width",
  "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where microplastics have been found" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "image_picker", "id": "image", "label": "Figure image" },
    { "type": "number", "id": "width", "label": "Figure width on desktop (px)", "default": 420 },
    { "type": "select", "id": "scheme", "label": "Colours", "default": "dark", "options": [{ "value": "dark", "label": "Dark" }, { "value": "cream", "label": "Cream" }] },
    { "type": "textarea", "id": "note", "label": "Closing line" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "stat", "label": "Big line", "info": "Short and striking, e.g. 8 in 10 people" },
        { "type": "text", "id": "title", "label": "Body part", "default": "Blood" },
        { "type": "text", "id": "text", "label": "Finding" },
        { "type": "text", "id": "source", "label": "Source" },
        { "type": "url", "id": "url", "label": "Source link" },
        { "type": "number", "id": "x", "label": "Point across (%)", "default": 50 },
        { "type": "number", "id": "y", "label": "Point down (%)", "default": 50 },
        { "type": "number", "id": "label_y", "label": "Label down (%)", "default": 50 },
        { "type": "select", "id": "side", "label": "Label side", "default": "l", "options": [{ "value": "l", "label": "Left" }, { "value": "r", "label": "Right" }] }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Everden body map", "blocks": [{ "type": "point" }, { "type": "point" }] }]
}
{% endschema %}
