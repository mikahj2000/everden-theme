<style>
  .evc{--ink:#17181B;--stone:#EEEAE4;--stone2:#E1DAD0;--ember:#D63A2F;--text:#3A3A3F;--line:#CFC7BB;color:var(--ink);background:var(--stone)}
  .evc *{box-sizing:border-box}
  .evc-wrap{max-width:1100px;margin:0 auto;padding:64px 20px 80px}
  .evc-head{text-align:center;max-width:680px;margin:0 auto 44px}
  .evc-eyebrow{font-size:13px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:var(--ember);margin:0 0 12px}
  .evc-head h1{font-size:clamp(34px,5vw,56px);line-height:1.02;letter-spacing:-.025em;font-weight:900;margin:0 0 14px}
  .evc-head p{font-size:18px;line-height:1.5;color:var(--text);margin:0}
  .evc-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:start}
  .evc-card{background:#fff;border-radius:22px;padding:30px}
  .evc-card h2{font-size:24px;font-weight:800;margin:0 0 6px}
  .evc-card > p{font-size:16px;line-height:1.5;color:var(--text);margin:0 0 20px}
  .evc-ways{display:grid;gap:10px;margin:0 0 24px;padding:0;list-style:none}
  .evc-ways li{display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.45;color:var(--text)}
  .evc-ways b{display:block;color:var(--ink);font-size:15px}
  .evc-ways a{color:var(--ember);font-weight:700;text-decoration:underline;text-underline-offset:3px;word-break:break-word}
  .evc-dot{flex-shrink:0;width:10px;height:10px;border-radius:5px;background:var(--ember);margin-top:6px}
  .evc-form{display:grid;gap:14px}
  .evc-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .evc-field{display:grid;gap:6px}
  .evc-field label{font-size:14px;font-weight:700}
  .evc-field label span{font-weight:500;color:#6B6760}
  .evc-field input,.evc-field textarea{width:100%;font:inherit;font-size:16px;color:var(--ink);background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:12px 14px}
  .evc-field textarea{min-height:140px;resize:vertical}
  .evc-field input:focus,.evc-field textarea:focus{outline:none;border-color:var(--ember);box-shadow:0 0 0 3px rgba(214,58,47,.15)}
  .evc-btn{justify-self:start;display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 30px;border:0;border-radius:999px;background:var(--ember);color:#fff;font-size:16px;font-weight:700;cursor:pointer}
  .evc-btn:hover{background:#B9301F}
  .evc-ok{background:#E7F1E5;color:#1F4D22;border-radius:12px;padding:14px 16px;font-size:15px;font-weight:600;margin:0 0 16px}
  .evc-err{background:#F7E3E0;color:#7A1E18;border-radius:12px;padding:14px 16px;font-size:15px;margin:0 0 16px}
  .evc-faq h2{font-size:24px;font-weight:800;margin:0 0 6px}
  .evc-faq details{border-bottom:1px solid var(--line);padding:16px 0}
  .evc-faq details:last-of-type{border-bottom:0}
  .evc-faq summary{cursor:pointer;list-style:none;font-size:17px;font-weight:700;display:flex;justify-content:space-between;gap:16px}
  .evc-faq summary::-webkit-details-marker{display:none}
  .evc-faq summary::after{content:"+";color:var(--ember);font-size:22px;line-height:1}
  .evc-faq details[open] summary::after{content:"\2212"}
  .evc-faq details p{margin:10px 0 0;font-size:15px;line-height:1.6;color:var(--text)}
  .evc-faq details a{color:var(--ember);font-weight:600}
  .evc-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
  .evc-links a{display:inline-flex;align-items:center;min-height:40px;padding:0 16px;border-radius:999px;border:1.5px solid var(--ink);color:var(--ink);font-size:14px;font-weight:700;text-decoration:none}
  .evc-links a:hover{background:var(--ink);color:var(--stone)}
  @media (max-width:899px){ .evc-grid{grid-template-columns:1fr} }
  @media (max-width:599px){ .evc-wrap{padding:44px 16px 56px} .evc-row{grid-template-columns:1fr} .evc-card{padding:22px} }
</style>

<div class="evc">
  <div class="evc-wrap">
    <div class="evc-head">
      <p class="evc-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.intro }}</p>
    </div>

    <div class="evc-grid">
      <div class="evc-card" id="evc-contact">
        <h2>Send us a message</h2>
        <p>{{ section.settings.reply_text }}</p>

        <ul class="evc-ways">
          {%- if section.settings.email != blank -%}
            <li><span class="evc-dot" aria-hidden="true"></span><span><b>Email</b><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></span></li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li><span class="evc-dot" aria-hidden="true"></span><span><b>Phone</b><a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' }}">{{ section.settings.phone }}</a></span></li>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <li><span class="evc-dot" aria-hidden="true"></span><span><b>Hours</b>{{ section.settings.hours }}</span></li>
          {%- endif -%}
        </ul>

        {%- form 'contact', id: 'EverdenContactForm', class: 'evc-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="evc-ok" role="status">Thanks! Your message is on its way. We'll get back to you soon.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="evc-err" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="evc-row">
            <div class="evc-field">
              <label for="evc-name">Name</label>
              <input id="evc-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
            </div>
            <div class="evc-field">
              <label for="evc-email">Email</label>
              <input id="evc-email" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
            </div>
          </div>
          <div class="evc-field">
            <label for="evc-order">Order number <span>(optional)</span></label>
            <input id="evc-order" type="text" name="contact[Order number]" placeholder="e.g. #1001">
          </div>
          <div class="evc-field">
            <label for="evc-message">How can we help?</label>
            <textarea id="evc-message" name="contact[body]" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="evc-btn">Send message</button>
        {%- endform -%}
      </div>

      <div class="evc-card evc-faq">
        <h2>Quick answers</h2>
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <p>{{ block.settings.answer }}</p>
          </details>
        {%- endfor -%}
        <div class="evc-links">
          <a href="/policies/shipping-policy">Shipping policy</a>
          <a href="/policies/refund-policy">Refund policy</a>
          <a href="/policies/privacy-policy">Privacy policy</a>
          <a href="/policies/terms-of-service">Terms of service</a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Everden customer service",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer service" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How can we help?" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Questions about your order, your wrap or our 30-day guarantee? We're real people and we're happy to help." },
    { "type": "textarea", "id": "reply_text", "label": "Reply time text", "default": "Fill out the form or email us. We reply within 1–2 business days." },
    { "type": "text", "id": "email", "label": "Support email" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Monday to Friday" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Answer" }
      ]
    }
  ],
  "presets": [ { "name": "Everden customer service" } ]
}
{% endschema %}
