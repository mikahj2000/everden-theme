{%- comment -%} Study cards with sources. Keep every figure exactly as the source states it. {%- endcomment -%}
<style>
  .evr{--ivory:#F6F2EB;--esp:#1F1A16;--umber:#5E4C3E;--muted:#8A7B6D;--stone:#E7DFD3;--teak:#8A5A36;--serif:"Cormorant Garamond","Cormorant",Garamond,"Times New Roman",serif;background:var(--esp);color:#F6F2EB}
  .evr *{box-sizing:border-box}
  .evr__wrap{max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,104px) clamp(20px,4vw,48px)}
  .evr__head{max-width:640px;margin:0 auto clamp(36px,5vw,56px);text-align:center}
  .evr__label{font-size:11px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;margin:0 0 16px;color:#C9B7A3}
  .evr__h2{font-family:var(--serif);font-weight:500;font-size:clamp(32px,4vw,50px);line-height:1.06;margin:0 0 16px;text-wrap:balance}
  .evr__intro{font-size:16px;line-height:1.7;color:#D9CFC2;margin:0}
  .evr__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px}
  .evr__card{background:#2A231E;border:1px solid #3A312A;padding:28px 26px;display:flex;flex-direction:column;gap:12px}
  .evr__stat{font-family:var(--serif);font-size:clamp(36px,3.6vw,46px);line-height:1;font-weight:500;color:#E9C9A4;margin:0}
  .evr__statl{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#C9B7A3;margin:0}
  .evr__title{font-size:17px;font-weight:600;margin:4px 0 0;line-height:1.35}
  .evr__text{font-size:14.5px;line-height:1.65;color:#D9CFC2}
  .evr__text p{margin:0 0 8px}
  .evr__src{margin-top:auto;padding-top:10px;border-top:1px solid #3A312A;font-size:12.5px;line-height:1.5;color:#B4A595}
  .evr__src a{color:#E9C9A4;text-underline-offset:3px}
  .evr__note{max-width:720px;margin:clamp(28px,4vw,40px) auto 0;font-size:13.5px;line-height:1.65;color:#B4A595;text-align:center}
</style>
<div class="evr">
  <div class="evr__wrap">
    <div class="evr__head">
      {%- if section.settings.label != blank -%}<p class="evr__label">{{ section.settings.label }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="evr__h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="evr__intro">{{ section.settings.intro }}</p>{%- endif -%}
    </div>
    <div class="evr__grid">
      {%- for block in section.blocks -%}
        <article class="evr__card" {{ block.shopify_attributes }}>
          {%- if block.settings.stat != blank -%}<p class="evr__stat">{{ block.settings.stat }}</p>{%- endif -%}
          {%- if block.settings.stat_label != blank -%}<p class="evr__statl">{{ block.settings.stat_label }}</p>{%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="evr__title">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="evr__text">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.source != blank -%}
            <p class="evr__src">Source:
              {% if block.settings.url != blank %}<a href="{{ block.settings.url }}" target="_blank" rel="noopener">{{ block.settings.source }}</a>{% else %}{{ block.settings.source }}{% endif %}
            </p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="evr__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Everden research",
  "tag": "section",
  "class": "section section--full-width",
  "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What the research shows" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "textarea", "id": "note", "label": "Footnote" }
  ],
  "blocks": [
    {
      "type": "study",
      "name": "Study",
      "settings": [
        { "type": "text", "id": "stat", "label": "Big figure" },
        { "type": "text", "id": "stat_label", "label": "Figure label" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "source", "label": "Source name" },
        { "type": "url", "id": "url", "label": "Source link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Everden research", "blocks": [{ "type": "study" }, { "type": "study" }] }]
}
{% endschema %}
