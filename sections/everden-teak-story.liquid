{%- assign second = product.media[1] -%}
<style>
  .lxs{--ivory:#F6F2EB;--paper:#FBF9F5;--esp:#1F1A16;--umber:#5E4C3E;--muted:#8A7B6D;--stone:#E7DFD3;--teak:#8A5A36;--serif:"Cormorant Garamond","Cormorant",Garamond,"Times New Roman",serif;color:var(--esp);background:var(--ivory)}
  .lxs *{box-sizing:border-box}
  .lxs-wrap{max-width:1280px;margin:0 auto;padding:clamp(72px,10vw,128px) clamp(20px,4vw,48px)}
  .lxs-label{font-size:11px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;margin:0 0 22px;color:var(--muted)}
  .lxs-h2{font-family:var(--serif);font-weight:500;font-size:clamp(32px,4.2vw,54px);line-height:1.05;margin:0 0 24px;text-wrap:balance;overflow-wrap:break-word}
  .lxs-p{font-size:16px;line-height:1.75;color:var(--umber);margin:0}
  .lxs-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(40px,7vw,110px);align-items:center}
  .lxs-img{aspect-ratio:4/5;overflow:hidden;background:linear-gradient(160deg,#B48A62 0%,#8A5A36 45%,#5B3A22 100%)}
  .lxs-img img{width:100%;height:100%;object-fit:cover;display:block}
  .lxs-props{list-style:none;margin:36px 0 0;padding:0;border-top:1px solid var(--stone)}
  .lxs-props li{display:grid;grid-template-columns:150px 1fr;gap:20px;padding:20px 0;border-bottom:1px solid var(--stone);font-size:15px;line-height:1.6;color:var(--umber)}
  .lxs-props b{font-family:var(--serif);font-weight:600;font-size:20px;color:var(--esp);line-height:1.2}
  .lxs-band{background:var(--stone)}
  .lxs-ritual{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(28px,4vw,64px);margin:56px 0 0;list-style:none;padding:0}
  .lxs-ritual li{border-top:1px solid rgba(31,26,22,.25);padding-top:26px}
  .lxs-ritual span{display:block;font-family:var(--serif);font-size:20px;color:var(--teak);margin-bottom:14px}
  .lxs-ritual h3{font-family:var(--serif);font-weight:500;font-size:26px;margin:0 0 10px}
  .lxs-ritual p{font-size:15px;line-height:1.7;color:var(--umber);margin:0}
  .lxs-note{margin:48px 0 0;font-size:13px;letter-spacing:.04em;color:var(--umber)}
  .lxs-faq{max-width:820px;margin:0 auto;border-top:1px solid var(--stone)}
  .lxs-faq details{border-bottom:1px solid var(--stone);padding:24px 0}
  .lxs-faq summary{cursor:pointer;list-style:none;font-family:var(--serif);font-weight:500;font-size:22px;display:flex;justify-content:space-between;gap:20px}
  .lxs-faq summary::-webkit-details-marker{display:none}
  .lxs-faq summary::after{content:"+";font-weight:400;color:var(--muted)}
  .lxs-faq details[open] summary::after{content:"\2212"}
  .lxs-faq details p{margin:14px 0 0;font-size:15px;line-height:1.75;color:var(--umber);max-width:640px}
  .lxs-center{text-align:center}
  .lxs-promise{font-family:var(--serif);font-weight:500;font-size:clamp(24px,2.8vw,34px);line-height:1.35;max-width:760px;margin:0 auto;text-wrap:balance}
  @media (max-width:899px){ .lxs-split{grid-template-columns:1fr} .lxs-ritual{grid-template-columns:1fr} }
  @media (max-width:599px){ .lxs-props li{grid-template-columns:1fr;gap:6px} }
</style>

<div class="lxs">

  <div class="lxs-wrap">
    <div class="lxs-split">
      <div class="lxs-img">
        {%- if second -%}
          {{ second.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 100vw, 50vw', alt: product.title }}
        {%- endif -%}
      </div>
      <div>
        <p class="lxs-label">The material</p>
        <h2 class="lxs-h2">Teak, chosen for the way it ages.</h2>
        <p class="lxs-p">For centuries teak has been the wood of ships' decks and garden furniture, trusted where water and weather would ruin anything else. In the kitchen, those same qualities give you a piece that improves with use.</p>
        <ul class="lxs-props">
          <li><b>Natural oils</b><span>Rich in its own oils, which help the wood resist moisture.</span></li>
          <li><b>Dense grain</b><span>Tight and stable, so it holds its shape and resists cracking.</span></li>
          <li><b>Its own figure</b><span>Cut from real timber. The grain on your piece is yours alone.</span></li>
        </ul>
      </div>
    </div>
  </div>

  {% render 'everden-compare' %}

  <div class="lxs-band">
    <div class="lxs-wrap">
      <p class="lxs-label">The ritual of care</p>
      <h2 class="lxs-h2" style="max-width:16ch">A few minutes, and it lasts for years.</h2>
      <ol class="lxs-ritual">
        <li><span>I</span><h3>Wash by hand</h3><p>Warm water and a little mild soap, straight after use.</p></li>
        <li><span>II</span><h3>Dry upright</h3><p>Towel it dry and stand it on its edge, so air reaches every side.</p></li>
        <li><span>III</span><h3>Oil each month</h3><p>Work in food-grade mineral oil, leave it overnight, then buff away the excess.</p></li>
      </ol>
      <p class="lxs-note">Teak should never go in the dishwasher or be left to soak.</p>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="lxs-wrap">
      <p class="lxs-label lxs-center">Questions</p>
      <h2 class="lxs-h2 lxs-center" style="margin-bottom:48px">Before you order</h2>
      <div class="lxs-faq">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <p>{{ block.settings.answer }}</p>
          </details>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="lxs-wrap lxs-center" style="padding-top:0">
    <p class="lxs-label">Our promise</p>
    <p class="lxs-promise">{{ section.settings.promise_text }}</p>
  </div>

</div>

{% schema %}
{
  "name": "Everden teak story",
  "tag": "section",
  "class": "section section--full-width",
  "settings": [
    { "type": "textarea", "id": "promise_text", "label": "Promise text", "default": "Every order ships tracked. If a piece isn't right for your home, tell us within 30 days of delivery for a full refund." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Answer" }
      ]
    }
  ],
  "presets": [ { "name": "Everden teak story" } ]
}
{% endschema %}
