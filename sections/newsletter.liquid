<section class="section section--deep">
  <div class="page-width">
    <div class="newsletter">
      {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
      {%- form 'customer', class: 'newsletter__form', id: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
        <input class="field" id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.email' | t }}" required>
        <button class="button button--primary" type="submit">{{ section.settings.button_label }}</button>
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" style="flex-basis:100%">{{ 'newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-message form-message--error" style="flex-basis:100%">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email sign-up",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Join the Everden list" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Routine tips and early offers" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Short, useful emails about building a daily knee routine, plus first access to new offers. No spam.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" }
  ],
  "presets": [{ "name": "Email sign-up" }]
}
{% endschema %}
