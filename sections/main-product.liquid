{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_list = product.media | where: 'media_type', 'image'
-%}
<section class="page-width">
  <div class="product">
    <div class="product__gallery" data-gallery>
      <div class="gallery__main">
        {%- if media_list.size > 0 -%}
          {%- for media in media_list -%}
            {%- liquid
              assign active = false
              if current_variant.featured_media and current_variant.featured_media.id == media.id
                assign active = true
              elsif current_variant.featured_media == blank and forloop.first
                assign active = true
              endif
            -%}
            <div class="gallery__slide{% if active %} is-active{% endif %}" data-slide="{{ media.id }}">
              <div class="media media--contain" style="aspect-ratio: 1 / 1;">
                {%- assign load = 'lazy' -%}
                {%- if forloop.first -%}{%- assign load = 'eager' -%}{%- endif -%}
                {{ media.preview_image | image_url: width: 1400 | image_tag: loading: load, sizes: '(min-width: 990px) 50vw, 100vw', widths: '500, 800, 1100, 1400', alt: media.alt | default: product.title }}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {% render 'media', label: 'Product photo on a plain light background', ratio: '1 / 1' %}
        {%- endif -%}
      </div>
      {%- if media_list.size > 1 -%}
        <div class="gallery__thumbs">
          {%- for media in media_list -%}
            <button type="button" class="gallery__thumb" data-thumb="{{ media.id }}" aria-label="Show image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow product__vendor">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="product__title">{{ section.settings.title_override | default: product.title }}</h1>
      {%- if section.settings.subtitle != blank -%}<p class="product__subtitle">{{ section.settings.subtitle }}</p>{%- endif -%}

      {%- assign bullets = section.settings.bullets | newline_to_br | split: '<br />' -%}
      {%- if section.settings.bullets != blank -%}
        <ul class="checklist">
          {%- for line in bullets -%}
            {%- assign t = line | strip -%}
            {%- if t != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ t }}</span></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div data-main-price>{% render 'price', variant: current_variant %}</div>
      {%- if section.settings.price_note != blank -%}<p class="product__price-note">{{ section.settings.price_note }}</p>{%- endif -%}

      {%- form 'product', product, class: 'product-form', data-product-form: '', data-currency: cart.currency.iso_code -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          <fieldset class="bundles">
            <legend>{{ section.settings.bundle_heading | default: 'products.choose' | t }}</legend>
            {%- for variant in product.variants -%}
              <label class="bundle{% unless variant.available %} is-unavailable{% endunless %}">
                {%- if forloop.index == section.settings.highlight_position and section.settings.highlight_text != blank -%}
                  <span class="bundle__tag">{{ section.settings.highlight_text }}</span>
                {%- endif -%}
                <input type="radio" name="bundle" value="{{ variant.id }}"{% if variant.id == current_variant.id %} checked{% endif %}>
                <span class="bundle__info">
                  <span class="bundle__title">{{ variant.title }}</span>
                  {%- if variant.compare_at_price > variant.price -%}
                    <span class="bundle__note">You save {{ variant.compare_at_price | minus: variant.price | money_without_trailing_zeros }}</span>
                  {%- elsif variant.available == false -%}
                    <span class="bundle__note">{{ 'products.sold_out' | t }}</span>
                  {%- endif -%}
                </span>
                <span class="bundle__price">
                  {{ variant.price | money }}
                  {%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
                </span>
              </label>
            {%- endfor -%}
          </fieldset>
          <script type="application/json" data-variants>
            [{%- for v in product.variants -%}{"id":{{ v.id }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 0 }},"available":{{ v.available }},"media_id":{{ v.featured_media.id | default: 'null' }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
          </script>
        {%- endunless -%}

        <div class="product-form__buttons">
          <button type="submit" name="add" class="button button--primary button--full" data-add-button data-add-label="{{ 'products.add_to_cart' | t }}" data-sold-out-label="{{ 'products.sold_out' | t }}"{% unless current_variant.available %} disabled{% endunless %}>
            <span>{%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
          </button>
          {%- if section.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
        </div>
      {%- endform -%}

      <div class="product__trust">
        {%- for i in (1..3) -%}
          {%- liquid
            assign icon_key = 'trust_icon_' | append: i
            assign text_key = 'trust_text_' | append: i
          -%}
          {%- if section.settings[text_key] != blank -%}
            <div>{% render 'icon', name: section.settings[icon_key] %}{{ section.settings[text_key] }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="product__accordions">
        {%- if product.description != blank -%}
          <details class="accordion">
            <summary>Description{% render 'icon', name: 'plus' %}</summary>
            <div class="accordion__body rte">{{ product.description }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.specs != blank -%}
          <details class="accordion">
            <summary>Specs{% render 'icon', name: 'plus' %}</summary>
            <div class="accordion__body">
              <table class="specs">
                {%- assign spec_lines = section.settings.specs | newline_to_br | split: '<br />' -%}
                {%- for line in spec_lines -%}
                  {%- assign parts = line | strip | split: ':' -%}
                  {%- if parts.size > 1 -%}
                    <tr><td>{{ parts.first | strip }}</td><td>{{ line | strip | remove_first: parts.first | remove_first: ':' | strip }}</td></tr>
                  {%- endif -%}
                {%- endfor -%}
              </table>
            </div>
          </details>
        {%- endif -%}
        {%- for i in (1..3) -%}
          {%- liquid
            assign title_key = 'tab_title_' | append: i
            assign body_key = 'tab_body_' | append: i
          -%}
          {%- if section.settings[title_key] != blank and section.settings[body_key] != blank -%}
            <details class="accordion">
              <summary>{{ section.settings[title_key] }}{% render 'icon', name: 'plus' %}</summary>
              <div class="accordion__body rte">{{ section.settings[body_key] }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | default: section.settings.subtitle | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
    {%- if product.featured_image -%}"image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},{%- endif -%}
    "offers": [
      {%- for v in product.variants -%}
        {
          "@type": "Offer",
          "sku": {{ v.sku | json }},
          "price": {{ v.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": {{ request.origin | append: v.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label above title", "default": "Everden" },
    { "type": "text", "id": "title_override", "label": "Display title", "info": "Optional. Shows instead of the product's title, which keeps a long supplier title out of the page." },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "textarea", "id": "bullets", "label": "Checklist", "info": "One point per line." },
    { "type": "text", "id": "price_note", "label": "Note under price", "default": "Ships in 1–2 weeks · 60-day guarantee" },
    { "type": "header", "content": "Bundle picker" },
    { "type": "paragraph", "content": "Shows when the product has variants, e.g. Single and 2-pack. Set a compare-at price on the 2-pack (two singles' price) to show the saving." },
    { "type": "text", "id": "bundle_heading", "label": "Heading", "default": "Choose your set" },
    { "type": "range", "id": "highlight_position", "label": "Highlighted option", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "text", "id": "highlight_text", "label": "Highlight label", "default": "Best value" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Buy it now button", "default": true },
    { "type": "header", "content": "Trust row" },
    { "type": "select", "id": "trust_icon_1", "label": "Icon 1", "default": "truck", "options": [{ "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" }, { "value": "clock", "label": "Clock" }, { "value": "battery", "label": "Battery" }] },
    { "type": "text", "id": "trust_text_1", "label": "Text 1", "default": "Tracked shipping" },
    { "type": "select", "id": "trust_icon_2", "label": "Icon 2", "default": "shield", "options": [{ "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" }, { "value": "clock", "label": "Clock" }, { "value": "battery", "label": "Battery" }] },
    { "type": "text", "id": "trust_text_2", "label": "Text 2", "default": "60-day guarantee" },
    { "type": "select", "id": "trust_icon_3", "label": "Icon 3", "default": "clock", "options": [{ "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" }, { "value": "clock", "label": "Clock" }, { "value": "battery", "label": "Battery" }] },
    { "type": "text", "id": "trust_text_3", "label": "Text 3", "default": "15-minute sessions" },
    { "type": "header", "content": "Details" },
    { "type": "textarea", "id": "specs", "label": "Specs", "info": "One per line, as Label: value" },
    { "type": "text", "id": "tab_title_1", "label": "Tab 1 title", "default": "How to use" },
    { "type": "richtext", "id": "tab_body_1", "label": "Tab 1 text" },
    { "type": "text", "id": "tab_title_2", "label": "Tab 2 title", "default": "Shipping & delivery" },
    { "type": "richtext", "id": "tab_body_2", "label": "Tab 2 text" },
    { "type": "text", "id": "tab_title_3", "label": "Tab 3 title", "default": "Safety" },
    { "type": "richtext", "id": "tab_body_3", "label": "Tab 3 text" }
  ]
}
{% endschema %}
