<section class="section section--deep">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <div class="spotlight">
      {% render 'media', image: section.settings.image, label: section.settings.image_label, ratio: '4 / 5', class: 'media--shadow', sizes: '(min-width: 750px) 50vw, 100vw' %}
      <ol class="points">
        {%- for block in section.blocks -%}
          <li class="point" {{ block.shopify_attributes }}>
            <span class="point__num">{{ forloop.index }}</span>
            <div>
              <h3>{{ block.settings.heading }}</h3>
              {{ block.settings.text }}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product close-up",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "A closer look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every part has a job" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_label", "label": "Placeholder description", "default": "Close-up of the control panel and LED grid" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Detail" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this detail.</p>" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Product close-up", "blocks": [{ "type": "point" }, { "type": "point" }] }]
}
{% endschema %}
