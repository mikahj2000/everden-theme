<section class="section section--deep">
  <div class="page-width inbox">
    {% render 'media', image: section.settings.image, label: section.settings.image_label, ratio: '1 / 1', class: 'media--shadow', sizes: '(min-width: 750px) 45vw, 100vw' %}
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <ul class="inbox__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %}<span><strong>{{ block.settings.item }}</strong>{% if block.settings.detail != blank %} — {{ block.settings.detail }}{% endif %}</span></li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.note != blank -%}<p class="inbox__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "In the box",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_label", "label": "Placeholder description", "default": "Flat lay: wrap, controller and charging cable" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "In the box" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Unbox it, charge it, strap it on" },
    { "type": "text", "id": "note", "label": "Note" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "item", "label": "Item", "default": "Item" },
        { "type": "text", "id": "detail", "label": "Detail" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "In the box", "blocks": [{ "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
