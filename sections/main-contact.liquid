<section class="main-page page-width">
  <h1 class="h2 main-page__title">{{ page.title }}</h1>
  {%- if page.content != blank -%}<div class="rte" style="margin-bottom:28px">{{ page.content }}</div>{%- endif -%}
  {%- form 'contact', class: 'contact-form' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success">{{ 'contact.success' | t }}</p>
    {%- elsif form.errors -%}
      <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label class="visually-hidden" for="ContactName">{{ 'contact.name' | t }}</label>
    <input class="field" id="ContactName" type="text" name="contact[name]" autocomplete="name" placeholder="{{ 'contact.name' | t }}" value="{{ form.name }}">
    <label class="visually-hidden" for="ContactEmail">{{ 'contact.email' | t }}</label>
    <input class="field" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'contact.email' | t }}" value="{{ form.email }}" required>
    <label class="visually-hidden" for="ContactBody">{{ 'contact.message' | t }}</label>
    <textarea class="field" id="ContactBody" name="contact[body]" placeholder="{{ 'contact.message' | t }}" required>{{ form.body }}</textarea>
    <div><button class="button button--primary" type="submit">{{ 'contact.send' | t }}</button></div>
  {%- endform -%}
</section>

{% schema %}
{ "name": "Contact form", "settings": [] }
{% endschema %}
