{%- comment -%} Moving sale banner. Renders only between the start and end times (Unix seconds, UTC). {%- endcomment -%}
{%- liquid
  assign now_s = 'now' | date: '%s' | plus: 0
  assign show = false
  if section.settings.enabled and now_s >= section.settings.start and now_s <= section.settings.end
    assign show = true
  endif
  if request.design_mode and section.settings.enabled
    assign show = true
  endif
  assign items = section.settings.items | newline_to_br | split: '<br />'
-%}
{%- if show -%}
<a class="esb" href="{{ section.settings.link | default: '/collections/all' }}" style="--esb-bg:{{ section.settings.bg }};--esb-fg:{{ section.settings.fg }};--esb-ac:{{ section.settings.accent }};--esb-dur:{{ section.settings.duration }}s">
  <div class="esb__track" aria-label="{{ items | join: ' · ' | strip_newlines | escape }}">
    {%- for r in (1..2) -%}
      <div class="esb__run"{% if r == 2 %} aria-hidden="true"{% endif %}>
        {%- for k in (1..3) -%}
          {%- for it in items -%}
            {%- assign s = it | strip -%}
            {%- if s != blank -%}<span class="esb__item">{{ s }}</span><span class="esb__dot" aria-hidden="true">✦</span>{%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</a>
{%- endif -%}
{% stylesheet %}
  .esb{display:block;overflow:hidden;background:var(--esb-bg);color:var(--esb-fg);text-decoration:none;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.08)}
  .esb__track{display:flex;width:max-content;animation:esb-move var(--esb-dur) linear infinite}
  .esb:hover .esb__track{animation-play-state:paused}
  .esb__run{display:flex;align-items:center;flex-shrink:0}
  .esb__item{font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap;padding:0 18px}
  .esb__item:first-child{color:var(--esb-ac)}
  .esb__dot{color:var(--esb-ac);font-size:11px}
  @keyframes esb-move{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.esb__track{animation:none}}
  @media (max-width:749px){.esb__item{font-size:11.5px;padding:0 12px}}
{% endstylesheet %}
{% schema %}
{
  "name": "Everden sale banner",
  "tag": "section",
  "class": "everden-sale-banner",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enabled", "default": true },
    { "type": "number", "id": "start", "label": "Start (Unix seconds, UTC)", "default": 0 },
    { "type": "number", "id": "end", "label": "End (Unix seconds, UTC)", "default": 0 },
    { "type": "textarea", "id": "items", "label": "Messages (one per line)" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0E0C0B" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#E3B96B" },
    { "type": "range", "id": "duration", "label": "Loop time (seconds)", "min": 10, "max": 80, "step": 2, "default": 36 }
  ],
  "presets": [{ "name": "Everden sale banner" }]
}
{% endschema %}
