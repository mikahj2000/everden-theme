<section class="main-page page-width">
  <h1 class="h2 main-page__title">Collections</h1>
  <ul class="product-grid">
    {%- for collection in collections -%}
      <li>
        <a class="product-card" href="{{ collection.url }}">
          {% render 'media', image: collection.featured_image, label: collection.title, ratio: '1 / 1' %}
          <h2 class="product-card__title">{{ collection.title }}</h2>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
