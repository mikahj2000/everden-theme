{%- comment -%} Editable comparison table: four columns, one block per row. The first column is highlighted as Everden's. {%- endcomment -%}
<style>
  .lxg{--ivory:#F6F2EB;--paper:#FBF9F5;--esp:#1F1A16;--umber:#5E4C3E;--muted:#8A7B6D;--stone:#E7DFD3;--teak:#8A5A36;--serif:"Cormorant Garamond","Cormorant",Garamond,"Times New Roman",serif;color:var(--esp);background:var(--ivory)}
  .lxg *{box-sizing:border-box}
  .lxg__wrap{max-width:1080px;margin:0 auto;padding:clamp(56px,8vw,112px) clamp(20px,4vw,48px)}
  .lxg__label{font-size:11px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;margin:0 0 18px;color:var(--muted);text-align:center}
  .lxg__h2{font-family:var(--serif);font-weight:500;font-size:clamp(30px,3.8vw,48px);line-height:1.08;margin:0 auto 16px;text-align:center;max-width:18ch;text-wrap:balance}
  .lxg__lede{font-size:16px;line-height:1.75;color:var(--umber);margin:0 auto 44px;text-align:center;max-width:560px}
  .lxg__scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
  .lxg table{width:100%;min-width:640px;border-collapse:separate;border-spacing:0;font-size:15px;line-height:1.5}
  .lxg th,.lxg td{padding:18px 16px;text-align:left;vertical-align:top;border-bottom:1px solid var(--stone)}
  .lxg thead th{font-family:var(--serif);font-weight:600;font-size:22px;padding-top:24px;border-bottom:1px solid rgba(31,26,22,.35)}
  .lxg tbody th{font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);width:20%}
  .lxg td{color:var(--umber);width:20%}
  .lxg .lxg__us{background:var(--paper);color:var(--esp)}
  .lxg thead .lxg__us{color:var(--teak);border-top:2px solid var(--teak)}
  .lxg td.lxg__us{font-weight:500}
  .lxg__note{margin:20px 0 0;font-size:12px;line-height:1.6;color:var(--muted);text-align:center}
  .lxg--3 th,.lxg--3 td{width:26%}
  .lxg--3 tbody th{width:22%}
  @media (max-width:599px){
    .lxg--3 thead tr,.lxg--3 tbody tr{grid-template-columns:repeat(3,minmax(0,1fr)) !important}
    .lxg table{min-width:0;font-size:13px}
    .lxg thead tr,.lxg tbody tr{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
    .lxg thead th:first-child{display:none}
    .lxg thead th{font-size:17px;padding:14px 6px}
    .lxg tbody th{grid-column:1 / -1;width:auto;border-bottom:0;padding:16px 6px 4px;font-size:11px}
    .lxg td{width:auto;padding:4px 6px 14px;font-size:12.5px;line-height:1.4}
  }
</style>
{%- assign has4 = false -%}{%- if section.settings.col4 != blank -%}{%- assign has4 = true -%}{%- endif -%}
<div class="lxg{% unless has4 %} lxg--3{% endunless %}">
  <div class="lxg__wrap">
    {%- if section.settings.label != blank -%}<p class="lxg__label">{{ section.settings.label }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="lxg__h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.lede != blank -%}<p class="lxg__lede">{{ section.settings.lede }}</p>{%- endif -%}
    <div class="lxg__scroll">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">{{ section.settings.row_header }}</span></th>
            <th scope="col" class="lxg__us">{{ section.settings.col1 }}</th>
            <th scope="col">{{ section.settings.col2 }}</th>
            <th scope="col">{{ section.settings.col3 }}</th>
            {%- if has4 -%}<th scope="col">{{ section.settings.col4 }}</th>{%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label }}</th>
              <td class="lxg__us">{{ block.settings.c1 }}</td>
              <td>{{ block.settings.c2 }}</td>
              <td>{{ block.settings.c3 }}</td>
              {%- if has4 -%}<td>{{ block.settings.c4 }}</td>{%- endif -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.note != blank -%}<p class="lxg__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Everden comparison grid",
  "tag": "section",
  "class": "section section--full-width",
  "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "lede", "label": "Intro line" },
    { "type": "text", "id": "row_header", "label": "Row header (screen readers)", "default": "Feature" },
    { "type": "text", "id": "col1", "label": "Column 1 (highlighted)", "default": "Teak" },
    { "type": "text", "id": "col2", "label": "Column 2" },
    { "type": "text", "id": "col3", "label": "Column 3" },
    { "type": "text", "id": "col4", "label": "Column 4", "info": "Leave empty for a three-column table." },
    { "type": "text", "id": "note", "label": "Footnote" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Row label", "default": "Feature" },
        { "type": "text", "id": "c1", "label": "Column 1" },
        { "type": "text", "id": "c2", "label": "Column 2" },
        { "type": "text", "id": "c3", "label": "Column 3" },
        { "type": "text", "id": "c4", "label": "Column 4" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Everden comparison grid", "blocks": [{ "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
