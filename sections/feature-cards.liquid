<section class="section section--deep">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <div class="cards">
      {%- for block in section.blocks -%}
        <div class="card" {{ block.shopify_attributes }}>
          <div class="card__icon">{% render 'icon', name: block.settings.icon %}</div>
          <h3>{{ block.settings.heading }}</h3>
          {{ block.settings.text }}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Built for real routines" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything in one wrap. Nothing to plug in." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "light", "options": [
          { "value": "light", "label": "Light" }, { "value": "wave", "label": "Vibration" }, { "value": "battery", "label": "Battery" },
          { "value": "power", "label": "Power button" }, { "value": "strap", "label": "Strap" }, { "value": "shield", "label": "Shield" },
          { "value": "clock", "label": "Clock" }, { "value": "heart", "label": "Heart" }, { "value": "gift", "label": "Gift" }, { "value": "home", "label": "Home" }
        ] },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Feature" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe the feature.</p>" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [{ "name": "Feature cards", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
