<section class="main-page page-width">
  <h1 class="h2 main-page__title">{%- if search.performed -%}{{ 'general.search_results' | t: terms: search.terms }}{%- else -%}{{ 'accessibility.search' | t }}{%- endif -%}</h1>
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="SearchInput">{{ 'accessibility.search' | t }}</label>
    <input class="field" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
    <button class="button button--primary" type="submit">{{ 'accessibility.search' | t }}</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <ul class="product-grid">
        {%- for item in search.results -%}
          <li>
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a class="product-card" href="{{ item.url }}"><h2 class="product-card__title">{{ item.title }}</h2></a>
            {%- endif -%}
          </li>
        {%- else -%}
          <li>{{ 'general.no_results' | t }}</li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
