<section class="section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <div class="story__rows">
      {%- for block in section.blocks -%}
        <div class="story__row" {{ block.shopify_attributes }}>
          <div class="story__media">
            {% render 'media', image: block.settings.image, label: block.settings.image_label, ratio: '1 / 1', class: 'media--shadow', sizes: '(min-width: 750px) 50vw, 100vw' %}
          </div>
          <div class="story__copy">
            <span class="story__num">{{ forloop.index }}</span>
            <h3>{{ block.settings.heading }}</h3>
            {{ block.settings.text }}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Numbered story",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor name", "default": "how-it-works", "info": "Buttons linking to #how-it-works scroll here." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Why Everden" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something to do that isn't another pill" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_label", "label": "Placeholder description", "default": "Photo" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Step heading" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this step.</p>" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Numbered story", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
