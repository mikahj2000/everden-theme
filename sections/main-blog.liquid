<section class="main-page page-width">
  <h1 class="h2 main-page__title">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="product-grid">
      {%- for article in blog.articles -%}
        <li>
          <a class="product-card" href="{{ article.url }}">
            {% render 'media', image: article.image, label: article.title, ratio: '4 / 3' %}
            <h2 class="product-card__title">{{ article.title }}</h2>
            <p style="font-size:.9rem">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
