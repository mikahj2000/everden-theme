<section class="section">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <div class="compare">
      <div class="compare__scroll">
        <table>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Feature</span></th>
              <th scope="col" class="compare__us">{{ section.settings.col_1 }}</th>
              <th scope="col">{{ section.settings.col_2 }}</th>
              {%- if section.settings.col_3 != blank -%}<th scope="col">{{ section.settings.col_3 }}</th>{%- endif -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row" style="font-weight:400">{{ block.settings.feature }}</th>
                <td class="compare__us">{% if block.settings.us %}{% render 'icon', name: 'check' %}<span class="visually-hidden">Yes</span>{% else %}{% render 'icon', name: 'x' %}<span class="visually-hidden">No</span>{% endif %}</td>
                <td>{% if block.settings.them_1 %}{% render 'icon', name: 'check' %}<span class="visually-hidden">Yes</span>{% else %}{% render 'icon', name: 'x' %}<span class="visually-hidden">No</span>{% endif %}</td>
                {%- if section.settings.col_3 != blank -%}
                  <td>{% if block.settings.them_2 %}{% render 'icon', name: 'check' %}<span class="visually-hidden">Yes</span>{% else %}{% render 'icon', name: 'x' %}<span class="visually-hidden">No</span>{% endif %}</td>
                {%- endif -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why choose one or the other?" },
    { "type": "text", "id": "col_1", "label": "Your column", "default": "Everden" },
    { "type": "text", "id": "col_2", "label": "Column 2", "default": "Heating pad" },
    { "type": "text", "id": "col_3", "label": "Column 3 (optional)", "default": "Clinic sessions" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Feature" },
        { "type": "checkbox", "id": "us", "label": "Your column has it", "default": true },
        { "type": "checkbox", "id": "them_1", "label": "Column 2 has it", "default": false },
        { "type": "checkbox", "id": "them_2", "label": "Column 3 has it", "default": false }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Comparison table", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
