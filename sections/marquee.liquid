{%- capture items -%}
  {%- for block in section.blocks -%}
    <span class="marquee__item">{{ block.settings.text }}</span><span class="marquee__sep" aria-hidden="true">✦</span>
  {%- endfor -%}
{%- endcapture -%}
{%- if section.blocks.size > 0 -%}
<div class="marquee" style="--marquee-speed: {{ section.settings.speed }}s;">
  <div class="marquee__track">
    {%- for i in (1..2) -%}
      <div class="marquee__group"{% if forloop.last %} aria-hidden="true"{% endif %}>{{ items }}{{ items }}</div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Scrolling text",
  "settings": [
    { "type": "range", "id": "speed", "label": "Seconds per loop", "min": 10, "max": 80, "step": 2, "default": 36 }
  ],
  "blocks": [
    { "type": "item", "name": "Phrase", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "15-minute ritual" }] }
  ],
  "presets": [{ "name": "Scrolling text", "blocks": [{ "type": "item" }] }]
}
{% endschema %}
