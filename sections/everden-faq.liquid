{%- comment -%} Product-specific FAQ, one block per question. {%- endcomment -%}
<style>
  .lxq{--paper:#FBF9F5;--esp:#1F1A16;--umber:#5E4C3E;--muted:#8A7B6D;--stone:#E7DFD3;--serif:"Cormorant Garamond","Cormorant",Garamond,"Times New Roman",serif;color:var(--esp);background:var(--paper)}
  .lxq *{box-sizing:border-box}
  .lxq__wrap{max-width:900px;margin:0 auto;padding:clamp(56px,8vw,112px) clamp(20px,4vw,48px)}
  .lxq__label{font-size:11px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;margin:0 0 18px;color:var(--muted);text-align:center}
  .lxq__h2{font-family:var(--serif);font-weight:500;font-size:clamp(30px,3.8vw,48px);line-height:1.08;margin:0 0 40px;text-align:center;text-wrap:balance}
  .lxq__list{border-top:1px solid var(--stone)}
  .lxq details{border-bottom:1px solid var(--stone);padding:22px 0}
  .lxq summary{cursor:pointer;list-style:none;font-family:var(--serif);font-weight:500;font-size:22px;display:flex;justify-content:space-between;gap:20px}
  .lxq summary::-webkit-details-marker{display:none}
  .lxq summary::after{content:"+";font-weight:400;color:var(--muted)}
  .lxq details[open] summary::after{content:"\2212"}
  .lxq summary:focus-visible{outline:2px solid var(--esp);outline-offset:4px}
  .lxq__a{margin:12px 0 0;font-size:15px;line-height:1.75;color:var(--umber);max-width:640px}
  .lxq__a p{margin:0}
</style>
<div class="lxq">
  <div class="lxq__wrap">
    {%- if section.settings.label != blank -%}<p class="lxq__label">{{ section.settings.label }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="lxq__h2">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="lxq__list">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="lxq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Everden FAQ",
  "tag": "section",
  "class": "section section--full-width",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Everden FAQ", "blocks": [{ "type": "faq" }, { "type": "faq" }] }]
}
{% endschema %}
