<section class="section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          <div class="step__media">
            {%- if block.settings.time != blank -%}<span class="step__time">{{ block.settings.time }}</span>{%- endif -%}
            {% render 'media', image: block.settings.image, label: block.settings.image_label, ratio: '1 / 1', sizes: '(min-width: 750px) 33vw, 100vw' %}
          </div>
          <h3><span>{{ forloop.index }}.</span> {{ block.settings.heading }}</h3>
          {{ block.settings.text }}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Routine steps",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor name", "default": "how-it-works" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The 15-minute ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps, one button" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_label", "label": "Placeholder description", "default": "Photo" },
        { "type": "text", "id": "time", "label": "Time tag", "default": "0:30" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Step" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this step.</p>" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Routine steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
