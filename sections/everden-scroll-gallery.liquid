{%- comment -%} Heading + feature list beside columns of photos that drift slowly up and down. {%- endcomment -%}
{%- liquid
  assign count = 0
  for i in (1..9)
    assign key = 'image_' | append: i
    if section.settings[key] != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
<style>
  .evs{--ivory:#F6F2EB;--esp:#1F1A16;--umber:#5E4C3E;--muted:#8A7B6D;--stone:#E7DFD3;--teak:#8A5A36;--serif:"Cormorant Garamond","Cormorant",Garamond,"Times New Roman",serif;background:#FBF9F5;color:var(--esp);overflow:hidden}
  .evs *{box-sizing:border-box}
  .evs__wrap{max-width:1180px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,48px);display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:clamp(32px,6vw,88px);align-items:center}
  .evs__label{font-size:11px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;margin:0 0 16px;color:var(--muted)}
  .evs__h2{font-family:var(--serif);font-weight:500;font-size:clamp(32px,4vw,50px);line-height:1.06;margin:0 0 16px;text-wrap:balance}
  .evs__intro{font-size:16px;line-height:1.7;color:var(--umber);margin:0 0 32px;max-width:44ch}
  .evs__feats{list-style:none;margin:0;padding:0;display:grid;gap:22px}
  .evs__feat{display:grid;grid-template-columns:44px 1fr;gap:16px;align-items:start}
  .evs__icon{width:44px;height:44px;border-radius:50%;background:var(--stone);color:var(--teak);display:grid;place-items:center}
  .evs__icon svg{width:21px;height:21px}
  .evs__ft{font-size:16px;font-weight:600;margin:2px 0 4px}
  .evs__fx{font-size:14.5px;line-height:1.6;color:var(--umber);margin:0}
  .evs__cols{display:grid;grid-template-columns:repeat(var(--cols),minmax(0,1fr));gap:14px;height:clamp(520px,62vw,680px);-webkit-mask-image:linear-gradient(transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(transparent,#000 12%,#000 88%,transparent)}
  .evs__col{overflow:hidden}
  .evs__track{display:grid;gap:14px;animation:evs-up var(--dur,46s) linear infinite}
  .evs__col:nth-child(even) .evs__track{animation-name:evs-down}
  .evs__track img{width:100%;aspect-ratio:3/4;height:auto;object-fit:cover;display:block;background:var(--stone)}
  @keyframes evs-up{from{transform:translateY(0)}to{transform:translateY(calc(-50% - 7px))}}
  @keyframes evs-down{from{transform:translateY(calc(-50% - 7px))}to{transform:translateY(0)}}
  .evs__cols:hover .evs__track{animation-play-state:paused}
  @media (max-width:749px){
    .evs__wrap{grid-template-columns:1fr}
    .evs__cols{height:440px;--cols:2 !important}
    .evs__col:nth-child(3){display:none}
  }
  @media (prefers-reduced-motion:reduce){.evs__track{animation:none}}
</style>
<div class="evs">
  <div class="evs__wrap">
    <div>
      {%- if section.settings.label != blank -%}<p class="evs__label">{{ section.settings.label }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="evs__h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="evs__intro">{{ section.settings.intro }}</p>{%- endif -%}
      <ul class="evs__feats" role="list">
        {%- for block in section.blocks -%}
          <li class="evs__feat" {{ block.shopify_attributes }}>
            <span class="evs__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19l7-7"/></svg>
                {%- when 'flame' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 01-10 0c0-2.5 1.5-4 2.5-5 .3 1.8 1.2 2.8 2.5 3 0-3.2-.5-5.6 0-8z"/></svg>
                {%- when 'hand' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 11V6.5a1.5 1.5 0 013 0V11m0-5.5V4.5a1.5 1.5 0 013 0V11m0-5a1.5 1.5 0 013 0v5m0-3a1.5 1.5 0 013 0v5.5c0 4-2.7 6.5-6.5 6.5-2.6 0-4.3-1.1-5.7-3.2L4.6 13a1.5 1.5 0 012.4-1.8L7 11"/></svg>
                {%- when 'pan' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="10" cy="13" rx="7" ry="4.5"/><path d="M17 13h5"/></svg>
                {%- when 'utensils' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="7" cy="6.5" rx="2.6" ry="3.5"/><path d="M7 10v11"/><path d="M14.5 3v6a2.5 2.5 0 005 0V3M17 3v18"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M8 12.3l2.6 2.6L16 9.5"/></svg>
              {%- endcase -%}
            </span>
            <div>
              <p class="evs__ft">{{ block.settings.title }}</p>
              {%- if block.settings.text != blank -%}<p class="evs__fx">{{ block.settings.text }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    {%- if count > 0 -%}
      {%- assign ncols = section.settings.columns -%}
      <div class="evs__cols" style="--cols:{{ ncols }}" aria-hidden="true">
        {%- for c in (1..ncols) -%}
          <div class="evs__col">
            <div class="evs__track" style="--dur:{{ forloop.index0 | times: 7 | plus: 40 }}s">
              {%- for pass in (1..2) -%}
                {%- for i in (1..9) -%}
                  {%- assign m = i | minus: c | modulo: ncols -%}
                  {%- assign key = 'image_' | append: i -%}
                  {%- assign img = section.settings[key] -%}
                  {%- if m == 0 and img != blank -%}
                    {{ img | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 50vw, 20vw', alt: '' }}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Everden moving photos",
  "tag": "section",
  "class": "section section--full-width",
  "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the way you cook" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "range", "id": "columns", "label": "Photo columns", "min": 2, "max": 3, "step": 1, "default": 3 },
    { "type": "paragraph", "content": "Photos are shared across the columns in order. Use 6 or 9 for even columns." },
    { "type": "image_picker", "id": "image_1", "label": "Photo 1" },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "image_3", "label": "Photo 3" },
    { "type": "image_picker", "id": "image_4", "label": "Photo 4" },
    { "type": "image_picker", "id": "image_5", "label": "Photo 5" },
    { "type": "image_picker", "id": "image_6", "label": "Photo 6" },
    { "type": "image_picker", "id": "image_7", "label": "Photo 7" },
    { "type": "image_picker", "id": "image_8", "label": "Photo 8" },
    { "type": "image_picker", "id": "image_9", "label": "Photo 9" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [{"value":"leaf","label":"Leaf"},{"value":"flame","label":"Flame"},{"value":"hand","label":"Hand"},{"value":"pan","label":"Pan"},{"value":"utensils","label":"Utensils"},{"value":"check","label":"Check"}] },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Everden moving photos", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
