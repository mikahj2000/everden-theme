{%- liquid
  assign shop_url = section.settings.shop_link | default: routes.all_products_collection_url
  assign featured = section.settings.featured_collection
-%}
<style>
  .lx{--ivory:#F6F2EB;--paper:#FBF9F5;--esp:#1F1A16;--umber:#5E4C3E;--muted:#8A7B6D;--stone:#E7DFD3;--teak:#8A5A36;--serif:"Cormorant Garamond","Cormorant",Garamond,"Times New Roman",serif;color:var(--esp);background:var(--ivory);font-weight:400}
  .lx *{box-sizing:border-box}
  .lx a{color:inherit}
  .lx-wrap{max-width:1280px;margin:0 auto;padding:clamp(80px,11vw,140px) clamp(20px,4vw,48px)}
  .lx-label{font-size:11px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;margin:0 0 22px;color:var(--muted)}
  .lx-h2{font-family:var(--serif);font-weight:500;font-size:clamp(34px,4.6vw,58px);line-height:1.04;letter-spacing:-.005em;margin:0;text-wrap:balance;overflow-wrap:break-word}
  .lx-p{font-size:16px;line-height:1.75;color:var(--umber);margin:0}
  .lx-cta{display:inline-flex;align-items:center;gap:14px;font-size:12px;font-weight:500;letter-spacing:.22em;text-transform:uppercase;text-decoration:none;padding:16px 0;border-bottom:1px solid currentColor}
  .lx-cta::after{content:"";width:28px;height:1px;background:currentColor;transition:width .3s}
  .lx-cta:hover::after{width:44px}
  .lx-btn{display:inline-flex;align-items:center;justify-content:center;min-height:54px;padding:0 38px;border:1px solid currentColor;font-size:12px;font-weight:500;letter-spacing:.22em;text-transform:uppercase;text-decoration:none;transition:background .3s,color .3s}
  .lx a:focus-visible{outline:2px solid var(--teak);outline-offset:4px}
  .lx-ph{position:relative;width:100%;height:100%;background:linear-gradient(160deg,#B48A62 0%,#8A5A36 45%,#5B3A22 100%);overflow:hidden}
  .lx-ph svg{position:absolute;inset:0;width:100%;height:100%;opacity:.22}
  .lx-img{overflow:hidden;background:var(--stone)}
  .lx-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1.2s cubic-bezier(.2,.6,.2,1)}
  a:hover .lx-img img{transform:scale(1.03)}

  .lx-hero{position:relative;min-height:min(90vh,920px);display:flex;align-items:flex-end;color:var(--ivory);background:var(--esp)}
  .lx-hero .lx-bg{position:absolute;inset:0}
  .lx-hero .lx-bg img{width:100%;height:100%;object-fit:cover;display:block}
  .lx-hero .lx-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,16,13,.62) 0%,rgba(20,16,13,.35) 38%,rgba(20,16,13,0) 70%),linear-gradient(180deg,rgba(20,16,13,.2) 0%,rgba(20,16,13,0) 35%,rgba(20,16,13,.45) 100%)}
  .lx-hero-in{position:relative;width:100%;max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,48px) clamp(56px,8vw,96px)}
  .lx-hero .lx-label{color:rgba(246,242,235,.8)}
  .lx-hero h1{font-family:var(--serif);font-weight:500;font-size:clamp(46px,7vw,104px);line-height:.98;letter-spacing:-.01em;margin:0 0 24px;max-width:11ch;text-wrap:balance}
  .lx-hero p{font-size:17px;line-height:1.65;max-width:440px;margin:0 0 34px;color:rgba(246,242,235,.88)}
  .lx-hero .lx-btn:hover{background:var(--ivory);color:var(--esp)}

  .lx-statement{text-align:center;max-width:900px;margin:0 auto}
  .lx-statement p{font-family:var(--serif);font-weight:500;font-size:clamp(26px,3.2vw,40px);line-height:1.3;color:var(--esp);margin:0;text-wrap:balance}
  .lx-statement .lx-label{margin-bottom:30px}

  .lx-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:48px}
  .lx-cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,2vw,28px)}
  .lx-tile{display:block;text-decoration:none}
  .lx-tile .lx-img{aspect-ratio:3/4}
  .lx-tile h3{font-family:var(--serif);font-weight:500;font-size:28px;margin:22px 0 6px}
  .lx-tile p{font-size:14px;line-height:1.6;color:var(--muted);margin:0}

  .lx-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(40px,7vw,110px);align-items:center}
  .lx-split .lx-img{aspect-ratio:4/5}
  .lx-split .lx-h2{margin-bottom:26px}
  .lx-props{list-style:none;margin:36px 0 0;padding:0;border-top:1px solid var(--stone)}
  .lx-props li{display:grid;grid-template-columns:150px 1fr;gap:20px;padding:20px 0;border-bottom:1px solid var(--stone);font-size:15px;line-height:1.6;color:var(--umber)}
  .lx-props b{font-family:var(--serif);font-weight:600;font-size:20px;color:var(--esp);line-height:1.2}

  .lx-products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(16px,2vw,28px)}
  .lx-card{display:block;text-decoration:none}
  .lx-card .lx-img{aspect-ratio:4/5;background:var(--paper)}
  .lx-card h3{font-family:var(--serif);font-weight:500;font-size:22px;margin:18px 0 4px}
  .lx-card p{margin:0;font-size:14px;color:var(--muted);font-variant-numeric:tabular-nums;letter-spacing:.02em}

  .lx-band{background:var(--stone)}
  .lx-ritual{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(28px,4vw,64px);margin-top:56px;list-style:none;padding:0}
  .lx-ritual li{border-top:1px solid rgba(31,26,22,.25);padding-top:26px}
  .lx-ritual span{display:block;font-family:var(--serif);font-size:20px;color:var(--teak);margin-bottom:14px}
  .lx-ritual h3{font-family:var(--serif);font-weight:500;font-size:26px;margin:0 0 10px}
  .lx-ritual p{font-size:15px;line-height:1.7;color:var(--umber);margin:0}
  .lx-note{margin:48px 0 0;font-size:13px;letter-spacing:.04em;color:var(--umber)}

  .lx-close{text-align:center}
  .lx-close .lx-h2{margin:0 auto 22px;max-width:14ch}
  .lx-close .lx-p{max-width:520px;margin:0 auto 38px}
  .lx-close .lx-btn{background:var(--esp);color:var(--ivory);border-color:var(--esp)}
  .lx-close .lx-btn:hover{background:transparent;color:var(--esp)}

  .lx-faq{max-width:820px;margin:48px auto 0;border-top:1px solid var(--stone)}
  .lx-faq details{border-bottom:1px solid var(--stone);padding:24px 0}
  .lx-faq summary{cursor:pointer;list-style:none;font-family:var(--serif);font-weight:500;font-size:22px;display:flex;justify-content:space-between;gap:20px}
  .lx-faq summary::-webkit-details-marker{display:none}
  .lx-faq summary::after{content:"+";font-family:inherit;font-weight:400;color:var(--muted)}
  .lx-faq details[open] summary::after{content:"\2212"}
  .lx-faq details p{margin:14px 0 0;font-size:15px;line-height:1.75;color:var(--umber);max-width:640px}

  .lx-gift{background:var(--esp);color:var(--ivory)}
  .lx-gift .lx-label{color:#C9B49C}
  .lx-gift .lx-split .lx-img{aspect-ratio:4/5}
  .lx-gift .lx-h2{margin-bottom:22px}
  .lx-gift .lx-p{color:#DCD2C5;margin-bottom:28px}
  .lx-gift-list{list-style:none;margin:0 0 36px;padding:0;border-top:1px solid rgba(246,242,235,.18)}
  .lx-gift-list li{padding:16px 0;border-bottom:1px solid rgba(246,242,235,.18);font-size:15px;line-height:1.6;color:#DCD2C5}
  .lx-gift-list b{font-family:var(--serif);font-weight:600;font-size:19px;color:var(--ivory);display:block;margin-bottom:2px}
  .lx-gift .lx-btn{background:var(--ivory);color:var(--esp);border-color:var(--ivory)}
  .lx-gift .lx-btn:hover{background:transparent;color:var(--ivory)}
  @media (max-width:899px){
    .lx-cols{grid-template-columns:1fr}
    .lx-tile .lx-img{aspect-ratio:4/5}
    .lx-split{grid-template-columns:1fr}
    .lx-products{grid-template-columns:repeat(2,minmax(0,1fr))}
    .lx-ritual{grid-template-columns:1fr}
  }
  @media (max-width:599px){
    .lx-props li{grid-template-columns:1fr;gap:6px}
    .lx-hero{min-height:82vh}
  }
  @media (prefers-reduced-motion:reduce){.lx-img img,.lx-cta::after,.lx-btn{transition:none}}
</style>

{%- capture grain -%}
  <svg viewBox="0 0 600 800" preserveAspectRatio="none" aria-hidden="true"><g fill="none" stroke="#F6F2EB" stroke-width="1.2">
    {%- for i in (0..26) -%}{%- assign y = i | times: 31 | minus: 20 -%}<path d="M-20 {{ y }} C 150 {{ y | minus: 26 }}, 300 {{ y | plus: 30 }}, 620 {{ y | minus: 8 }}"/>{%- endfor -%}
  </g></svg>
{%- endcapture -%}

<div class="lx">

  <div class="lx-hero">
    <div class="lx-bg">
      {%- if section.settings.hero_image -%}
        {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw' }}
      {%- else -%}
        <div class="lx-ph">{{ grain }}</div>
      {%- endif -%}
    </div>
    <div class="lx-hero-in">
      <p class="lx-label">{{ section.settings.hero_eyebrow }}</p>
      <h1>{{ section.settings.hero_heading }}</h1>
      <p>{{ section.settings.hero_text }}</p>
      <a class="lx-btn" href="{{ shop_url }}">Explore the collection</a>
    </div>
  </div>

  <div class="lx-wrap">
    <div class="lx-statement">
      <p class="lx-label">Everden</p>
      <p>{{ section.settings.statement }}</p>
    </div>
  </div>

  <div class="lx-wrap" style="padding-top:0">
    <div class="lx-head">
      <div>
        <p class="lx-label">The collection</p>
        <h2 class="lx-h2">For the counter and the table.</h2>
      </div>
      <a class="lx-cta" href="{{ shop_url }}">View all pieces</a>
    </div>
    <div class="lx-cols">
      {%- for i in (1..3) -%}
        {%- liquid
          assign k_title = 'cat' | append: i | append: '_title'
          assign k_text = 'cat' | append: i | append: '_text'
          assign k_image = 'cat' | append: i | append: '_image'
          assign k_coll = 'cat' | append: i | append: '_collection'
          assign c = section.settings[k_coll]
          assign c_url = c.url | default: shop_url
        -%}
        <a class="lx-tile" href="{{ c_url }}">
          <div class="lx-img">
            {%- if section.settings[k_image] -%}
              {{ section.settings[k_image] | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 100vw, 33vw' }}
            {%- else -%}
              <div class="lx-ph">{{ grain }}</div>
            {%- endif -%}
          </div>
          <h3>{{ section.settings[k_title] }}</h3>
          <p>{{ section.settings[k_text] }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>

  <div class="lx-wrap" style="padding-top:0" id="lx-material">
    <div class="lx-split">
      <div class="lx-img">
        {%- if section.settings.material_image -%}
          {{ section.settings.material_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 100vw, 50vw' }}
        {%- else -%}
          <div class="lx-ph">{{ grain }}</div>
        {%- endif -%}
      </div>
      <div>
        <p class="lx-label">The material</p>
        <h2 class="lx-h2">Teak, chosen for the way it ages.</h2>
        <p class="lx-p">For centuries teak has been the wood of ships' decks and garden furniture, trusted where water and weather would ruin anything else. In the kitchen, those same qualities give you a piece that improves with use.</p>
        <ul class="lx-props">
          <li><b>Natural oils</b><span>Rich in its own oils, which help the wood resist moisture.</span></li>
          <li><b>Dense grain</b><span>Tight and stable, so it holds its shape and resists cracking.</span></li>
          <li><b>Its own figure</b><span>Cut from real timber. The grain on your piece is yours alone.</span></li>
        </ul>
      </div>
    </div>
  </div>

  {% render 'everden-compare' %}

  {%- if featured != blank and featured.products_count > 0 -%}
    <div class="lx-wrap" style="padding-top:0">
      <div class="lx-head">
        <div>
          <p class="lx-label">Selected pieces</p>
          <h2 class="lx-h2">{{ section.settings.featured_heading }}</h2>
        </div>
        <a class="lx-cta" href="{{ featured.url }}">Shop all</a>
      </div>
      <div class="lx-products">
        {%- for prod in featured.products limit: 4 -%}
          <a class="lx-card" href="{{ prod.url }}">
            <div class="lx-img">
              {%- if prod.featured_image -%}
                {{ prod.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 50vw, 25vw' }}
              {%- else -%}
                <div class="lx-ph">{{ grain }}</div>
              {%- endif -%}
            </div>
            <h3>{{ prod.title }}</h3>
            <p>{{ prod.price | money }}</p>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- assign gp = section.settings.gift_product -%}
  <div class="lx-gift">
    <div class="lx-wrap">
      <div class="lx-split">
        <div>
          <p class="lx-label">{{ section.settings.gift_label }}</p>
          <h2 class="lx-h2">{{ section.settings.gift_heading }}</h2>
          <p class="lx-p">{{ section.settings.gift_text }}</p>
          <ul class="lx-gift-list">
            <li><b>Sent straight to them</b>Enter their name and address at checkout, and we'll ship it directly.</li>
            <li><b>{{ section.settings.gift_deadline }}</b>Every order ships tracked, with free US shipping.</li>
          </ul>
          {%- if gp -%}
            <a class="lx-btn" href="{{ gp.url }}">Shop {{ gp.title | remove: 'The ' }} · {{ gp.price | money_without_trailing_zeros }}</a>
          {%- else -%}
            <a class="lx-btn" href="{{ shop_url }}">Explore the collection</a>
          {%- endif -%}
        </div>
        <div class="lx-img">
          {%- if section.settings.gift_image -%}
            {{ section.settings.gift_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 899px) 100vw, 50vw' }}
          {%- else -%}
            <div class="lx-ph">{{ grain }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <div class="lx-band">
    <div class="lx-wrap">
      <p class="lx-label">The ritual of care</p>
      <h2 class="lx-h2" style="max-width:16ch">A few minutes, and it lasts for years.</h2>
      <ol class="lx-ritual">
        <li><span>I</span><h3>Wash by hand</h3><p>Warm water and a little mild soap, straight after use.</p></li>
        <li><span>II</span><h3>Dry upright</h3><p>Towel it dry and stand it on its edge, so air reaches every side.</p></li>
        <li><span>III</span><h3>Oil each month</h3><p>Work in food-grade mineral oil, leave it overnight, then buff away the excess.</p></li>
      </ol>
      <p class="lx-note">Teak should never go in the dishwasher or be left to soak.</p>
    </div>
  </div>

  <div class="lx-wrap lx-close">
    <p class="lx-label">Everden</p>
    <h2 class="lx-h2">{{ section.settings.close_heading }}</h2>
    <p class="lx-p">{{ section.settings.promise_text }}</p>
    <a class="lx-btn" href="{{ shop_url }}">Explore the collection</a>

    {%- if section.blocks.size > 0 -%}
      <div class="lx-faq" style="text-align:left">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <p>{{ block.settings.answer }}</p>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "Everden teak home",
  "tag": "section",
  "class": "section section--full-width",
  "settings": [
    { "type": "text", "id": "hero_eyebrow", "label": "Hero label", "default": "Teakwood for the kitchen" },
    { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "Made to be handed down." },
    { "type": "textarea", "id": "hero_text", "label": "Hero text", "default": "Cutting boards, utensils and serving pieces in solid teak. Made for daily use, and for the decades after." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (full width, landscape)" },
    { "type": "url", "id": "shop_link", "label": "Shop link (defaults to all products)" },
    { "type": "textarea", "id": "statement", "label": "Brand statement", "default": "We make a small range of kitchen pieces from a single material. Teak, chosen for how it handles water, wear and time." },
    { "type": "header", "content": "Collection tiles" },
    { "type": "text", "id": "cat1_title", "label": "Tile 1 title", "default": "Cutting Boards" },
    { "type": "text", "id": "cat1_text", "label": "Tile 1 text", "default": "For preparing, carving and serving." },
    { "type": "image_picker", "id": "cat1_image", "label": "Tile 1 image (portrait)" },
    { "type": "collection", "id": "cat1_collection", "label": "Tile 1 collection" },
    { "type": "text", "id": "cat2_title", "label": "Tile 2 title", "default": "Utensils" },
    { "type": "text", "id": "cat2_text", "label": "Tile 2 text", "default": "Spoons, spatulas and turners, shaped to the hand." },
    { "type": "image_picker", "id": "cat2_image", "label": "Tile 2 image (portrait)" },
    { "type": "collection", "id": "cat2_collection", "label": "Tile 2 collection" },
    { "type": "text", "id": "cat3_title", "label": "Tile 3 title", "default": "Serving" },
    { "type": "text", "id": "cat3_text", "label": "Tile 3 text", "default": "Boards, bowls and trays for the table." },
    { "type": "image_picker", "id": "cat3_image", "label": "Tile 3 image (portrait)" },
    { "type": "collection", "id": "cat3_collection", "label": "Tile 3 collection" },
    { "type": "header", "content": "Material" },
    { "type": "image_picker", "id": "material_image", "label": "Material image (portrait)" },
    { "type": "header", "content": "Selected pieces" },
    { "type": "collection", "id": "featured_collection", "label": "Collection to feature (hidden when empty)" },
    { "type": "text", "id": "featured_heading", "label": "Heading", "default": "Begin with these." },
    { "type": "header", "content": "Gift" },
    { "type": "text", "id": "gift_label", "label": "Gift label", "default": "The gift" },
    { "type": "text", "id": "gift_heading", "label": "Gift heading", "default": "A gift they'll keep for decades." },
    { "type": "textarea", "id": "gift_text", "label": "Gift text", "default": "Teak is made to be used every day and handed down. For a new home, a wedding, or anyone who loves to cook." },
    { "type": "text", "id": "gift_deadline", "label": "Gift deadline line", "default": "Order by December 5 for Christmas" },
    { "type": "product", "id": "gift_product", "label": "Gift product (button)" },
    { "type": "image_picker", "id": "gift_image", "label": "Gift image (portrait)" },
    { "type": "header", "content": "Closing" },
    { "type": "text", "id": "close_heading", "label": "Closing heading", "default": "Pieces for a lifetime of meals." },
    { "type": "textarea", "id": "promise_text", "label": "Closing text", "default": "Every order ships tracked. If a piece isn't right for your home, tell us within 30 days of delivery for a full refund." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Answer" }
      ]
    }
  ],
  "presets": [ { "name": "Everden teak home" } ]
}
{% endschema %}
