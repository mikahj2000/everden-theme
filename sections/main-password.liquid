<section class="main-page page-width" style="text-align:center;max-width:620px">
  <p class="eyebrow">{{ shop.name }}</p>
  <h1 class="h2 main-page__title">{{ 'general.password_title' | t }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'newsletter__form' -%}
    {%- if form.errors -%}<div class="form-message form-message--error" style="flex-basis:100%">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label class="visually-hidden" for="Password">Password</label>
    <input class="field" id="Password" type="password" name="password" placeholder="Password" autocomplete="current-password">
    <button class="button button--primary" type="submit">Enter</button>
  {%- endform -%}
</section>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
