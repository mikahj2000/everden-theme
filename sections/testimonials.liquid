{%- comment -%} Only real customer reviews belong here. The section hides itself until it has at least one review. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="section section--deep">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <div class="quotes">
      {%- for block in section.blocks -%}
        <figure class="card quote" {{ block.shopify_attributes }}>
          {% render 'stars' %}
          <h3>{{ block.settings.title }}</h3>
          <blockquote style="margin:0">{{ block.settings.text }}</blockquote>
          <figcaption class="quote__author">{{ block.settings.author }}{% if block.settings.verified %} · Verified buyer{% endif %}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "paragraph", "content": "Add only real reviews from real customers. This section stays hidden until you add one." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Everden stories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From people who use it every day" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Review" },
        { "type": "text", "id": "author", "label": "Name and city" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Customer reviews" }]
}
{% endschema %}
