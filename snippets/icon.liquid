{%- comment -%} Params: name. Simple line icons, 24px grid, stroke uses currentColor. {%- endcomment -%}
<svg class="icon icon--{{ name }}" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'shield' -%}<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'lock' -%}<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/>
    {%- when 'light' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    {%- when 'wave' -%}<path d="M2 12c2-4 4-4 6 0s4 4 6 0 4-4 6 0"/><path d="M2 17c2-4 4-4 6 0s4 4 6 0 4-4 6 0" opacity=".5"/>
    {%- when 'battery' -%}<rect x="2" y="7" width="18" height="10" rx="2"/><path d="M22 11v2"/><path d="M6 10v4M10 10v4M14 10v4"/>
    {%- when 'power' -%}<path d="M12 3v8"/><path d="M6.3 7.3a8 8 0 1011.4 0"/>
    {%- when 'strap' -%}<rect x="4" y="5" width="16" height="14" rx="4"/><path d="M4 10h16M4 14h16"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/>
    {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'x' -%}<path d="M7 7l10 10M17 7L7 17"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'cart' -%}<path d="M6 7h13l-1.5 9h-10z"/><path d="M6 7L5 3H2"/><circle cx="9" cy="20" r="1.2"/><circle cx="17" cy="20" r="1.2"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/>
    {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'image' -%}<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-9 9"/>
    {%- when 'gift' -%}<rect x="3" y="9" width="18" height="12" rx="1"/><path d="M3 13h18M12 9v12"/><path d="M12 9c-2-4-6-4-6-1.5S9 9 12 9zM12 9c2-4 6-4 6-1.5S15 9 12 9z"/>
    {%- when 'home' -%}<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/>
    {%- else -%}<circle cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
