{%- comment -%}
  Shows an uploaded image, or a labeled placeholder box until a photo is added.
  Params: image, label (what photo belongs here), sizes, class, loading, ratio (e.g. '4 / 5')
{%- endcomment -%}
{%- liquid
  assign r = ratio | default: '4 / 5'
  assign l = loading | default: 'lazy'
-%}
<div class="media {{ class }}" style="aspect-ratio: {{ r }};">
  {%- if image != blank -%}
    {{ image | image_url: width: 1600 | image_tag: loading: l, sizes: sizes, widths: '400, 600, 800, 1000, 1200, 1600', alt: image.alt | default: label }}
  {%- else -%}
    <div class="media__placeholder" role="img" aria-label="{{ label | escape }}">
      {% render 'icon', name: 'image' %}
      <span class="media__placeholder-tag">Photo placeholder</span>
      <span class="media__placeholder-label">{{ label }}</span>
    </div>
  {%- endif -%}
</div>
