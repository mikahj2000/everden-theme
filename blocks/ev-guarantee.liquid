{%- comment -%} Everden: guarantee card for the product buy box. {%- endcomment -%}
<div class="evg" {{ block.shopify_attributes }}>
  <svg class="evg-badge" viewBox="0 0 48 56" aria-hidden="true">
    <path d="M24 2 44 9v17c0 13.5-8.6 23.6-20 28C12.6 49.6 4 39.5 4 26V9z" fill="#FBF9F5" stroke="#8A5A36" stroke-width="2"/>
    <text x="24" y="29" text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-size="17" font-weight="600" fill="#1F1A16">{{ block.settings.days }}</text>
    <text x="24" y="38.5" text-anchor="middle" font-family="Arial, sans-serif" font-size="5.6" letter-spacing="1.2" fill="#8A5A36">DAYS</text>
  </svg>
  <div>
    <p class="evg-t">{{ block.settings.title }}</p>
    <p class="evg-p">{{ block.settings.text }}</p>
  </div>
</div>
<style>
  .evg{width:100%;display:grid;grid-template-columns:48px 1fr;gap:16px;align-items:center;padding:16px 18px;background:#FBF9F5;border:1px solid #E7DFD3;border-radius:12px}
  .evg-badge{width:44px;height:52px}
  .evg-t{margin:0 0 4px;font-family:"Cormorant Garamond",Georgia,serif;font-weight:600;font-size:19px;line-height:1.2;color:#1F1A16}
  .evg-p{margin:0;font-size:13.5px;line-height:1.5;color:#5E4C3E}
</style>

{% schema %}
{
  "name": "Guarantee card",
  "tag": null,
  "settings": [
    { "type": "text", "id": "days", "label": "Days", "default": "30" },
    { "type": "text", "id": "title", "label": "Title", "default": "30-day money-back guarantee" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Not right for your home? Tell us within 30 days of delivery for a full refund." }
  ],
  "presets": [ { "name": "Guarantee card" } ]
}
{% endschema %}
