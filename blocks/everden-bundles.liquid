{%- comment -%} Bundle picker (sale-aware) -%}
  "Buy more & save" picker. Choosing an option sets the Add to cart quantity.
  The savings themselves come from Shopify automatic discounts (quantity 2 and 3),
  so keep the prices here in step with those discounts.
{%- endcomment -%}
{%- assign p1 = block.settings.price_1 -%}
{%- liquid
  assign now_s = 'now' | date: '%s' | plus: 0
  assign sale = false
  if block.settings.sale_on and block.settings.sale_start > 0 and now_s >= block.settings.sale_start and now_s <= block.settings.sale_end
    assign sale = true
  endif
-%}
{%- assign each = closest.product.price | default: 13900 -%}
<div class="evb" id="evb-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if sale and block.settings.sale_heading != blank -%}
    <p class="evb__head evb__head--sale"><span>{{ block.settings.sale_heading }}</span></p>
  {%- elsif block.settings.heading != blank -%}
    <p class="evb__head"><span>{{ block.settings.heading }}</span></p>
  {%- endif -%}
  <div class="evb__list" role="radiogroup" aria-label="{{ block.settings.heading | default: 'Bundle' | escape }}">
    {%- for i in (1..3) -%}
      {%- liquid
        assign qty = i
        case i
          when 1
            assign title = block.settings.title_1
            assign total = block.settings.price_1
            assign tag = block.settings.tag_1
          when 2
            assign title = block.settings.title_2
            assign total = block.settings.price_2
            assign tag = block.settings.tag_2
          when 3
            assign title = block.settings.title_3
            assign total = block.settings.price_3
            assign tag = block.settings.tag_3
        endcase
        if sale
          case i
            when 1
              assign total = block.settings.sale_price_1
              assign tag = block.settings.sale_tag_1
            when 2
              assign total = block.settings.sale_price_2
              assign tag = block.settings.sale_tag_2
            when 3
              assign total = block.settings.sale_price_3
              assign tag = block.settings.sale_tag_3
          endcase
        endif
        assign total_cents = total | times: 100 | round
        assign full_cents = each | times: qty
        assign save_cents = full_cents | minus: total_cents
        assign per_cents = total_cents | divided_by: qty
      -%}
      {%- if total > 0 -%}
        <label class="evb__opt{% if i == 1 %} is-on{% endif %}">
          <input type="radio" name="evb-{{ block.id }}" value="{{ qty }}"{% if i == 1 %} checked{% endif %}>
          <span class="evb__dot" aria-hidden="true"></span>
          <span class="evb__main">
            <span class="evb__title">{{ title }}{% if tag != blank %}<span class="evb__tag">{{ tag }}</span>{% endif %}</span>
            <span class="evb__sub">
              {%- if qty > 1 -%}{{ per_cents | money_without_trailing_zeros }} per set{%- else -%}1 Teak Kitchen Set{%- endif -%}
            </span>
          </span>
          <span class="evb__price">
            <span class="evb__now">{{ total_cents | money_without_trailing_zeros }}</span>
            {%- if save_cents > 0 -%}
              <s class="evb__was">{{ full_cents | money_without_trailing_zeros }}</s>
              <span class="evb__save">Save {{ save_cents | money_without_trailing_zeros }}</span>
            {%- endif -%}
          </span>
        </label>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if sale and block.settings.sale_note != blank -%}<p class="evb__note">{{ block.settings.sale_note }}</p>
  {%- elsif block.settings.note != blank -%}<p class="evb__note">{{ block.settings.note }}</p>{%- endif -%}
</div>
<script>
  (function () {
    var root = document.getElementById('evb-{{ block.id }}');
    if (!root) return;
    function form() {
      var scope = root.closest('.shopify-section') || document;
      return scope.querySelector('product-form-component');
    }
    function apply(q) {
      var pf = form();
      if (!pf) return;
      pf.dataset.quantityDefault = String(q);
      var qInput = pf.querySelector('input[name="quantity"]:not([data-evb])');
      if (qInput) {
        qInput.value = q;
        qInput.dispatchEvent(new Event('input', { bubbles: true }));
        qInput.dispatchEvent(new Event('change', { bubbles: true }));
        return;
      }
      var f = pf.querySelector('form[data-type="add-to-cart-form"]');
      if (!f) return;
      var h = f.querySelector('input[data-evb]');
      if (!h) {
        h = document.createElement('input');
        h.type = 'hidden'; h.name = 'quantity'; h.setAttribute('data-evb', '');
        f.appendChild(h);
      }
      h.value = q;
    }
    root.addEventListener('change', function (e) {
      if (!e.target.matches('input[type="radio"]')) return;
      root.querySelectorAll('.evb__opt').forEach(function (o) { o.classList.toggle('is-on', o.contains(e.target)); });
      apply(Number(e.target.value));
    });
    var c = root.querySelector('input:checked');
    if (c) apply(Number(c.value));
  })();
</script>
{% stylesheet %}
  .evb{--esp:#1F1A16;--umber:#5E4C3E;--teak:#8A5A36;--stone:#E7DFD3;--paper:#FBF9F5;width:100%;color:var(--esp)}
  .evb__head{display:flex;align-items:center;gap:12px;margin:0 0 12px;font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--umber)}
  .evb__head::before,.evb__head::after{content:"";flex:1;height:1px;background:var(--stone)}
  .evb__list{display:grid;gap:10px}
  .evb__opt{position:relative;display:grid;grid-template-columns:20px 1fr auto;align-items:center;gap:14px;padding:16px 18px;background:var(--paper);border:1.5px solid var(--stone);cursor:pointer;transition:border-color .15s}
  .evb__opt:hover{border-color:#cdbfae}
  .evb__opt.is-on{border-color:var(--esp);background:#fff}
  .evb__opt input{position:absolute;opacity:0;pointer-events:none}
  .evb__opt:has(input:focus-visible){outline:2px solid var(--teak);outline-offset:2px}
  .evb__dot{width:20px;height:20px;border-radius:50%;border:1.5px solid #b9ab9b;display:grid;place-items:center}
  .evb__opt.is-on .evb__dot{border-color:var(--esp)}
  .evb__opt.is-on .evb__dot::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--esp)}
  .evb__main{display:grid;gap:3px;min-width:0}
  .evb__title{font-size:16px;font-weight:600;display:flex;flex-wrap:wrap;align-items:center;gap:8px}
  .evb__tag{font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;background:var(--teak);color:#fff;padding:3px 8px}
  .evb__sub{font-size:13.5px;color:var(--umber)}
  .evb__price{display:grid;justify-items:end;gap:2px;text-align:right}
  .evb__now{font-size:17px;font-weight:600}
  .evb__was{font-size:13px;color:#8A7B6D}
  .evb__save{font-size:12px;font-weight:600;color:var(--teak)}
  .evb__head--sale{color:#B4232A}
  .evb__note{margin:10px 0 0;font-size:13px;color:var(--umber);text-align:center}
{% endstylesheet %}
{% schema %}
{
  "name": "Everden bundles",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Prices must match the automatic discounts in Shopify (Discounts). The struck-through price is the product price times the quantity." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy more & save" },
    { "type": "text", "id": "title_1", "label": "Option 1 title", "default": "Buy 1" },
    { "type": "number", "id": "price_1", "label": "Option 1 total ($)", "default": 139 },
    { "type": "text", "id": "tag_1", "label": "Option 1 tag" },
    { "type": "text", "id": "title_2", "label": "Option 2 title", "default": "Buy 2" },
    { "type": "number", "id": "price_2", "label": "Option 2 total ($)", "default": 249 },
    { "type": "text", "id": "tag_2", "label": "Option 2 tag", "default": "Keep one, gift one" },
    { "type": "text", "id": "title_3", "label": "Option 3 title", "default": "Buy 3" },
    { "type": "number", "id": "price_3", "label": "Option 3 total ($)", "default": 349 },
    { "type": "text", "id": "tag_3", "label": "Option 3 tag", "default": "Best value" },
    { "type": "text", "id": "note", "label": "Note under options", "default": "Savings apply automatically at checkout." },
    { "type": "header", "content": "Sale prices (shown only between the start and end times)" },
    { "type": "checkbox", "id": "sale_on", "label": "Use sale prices", "default": false },
    { "type": "number", "id": "sale_start", "label": "Sale start (Unix seconds, UTC)", "default": 0 },
    { "type": "number", "id": "sale_end", "label": "Sale end (Unix seconds, UTC)", "default": 0 },
    { "type": "text", "id": "sale_heading", "label": "Sale heading" },
    { "type": "number", "id": "sale_price_1", "label": "Sale option 1 total ($)" },
    { "type": "text", "id": "sale_tag_1", "label": "Sale option 1 tag" },
    { "type": "number", "id": "sale_price_2", "label": "Sale option 2 total ($)" },
    { "type": "text", "id": "sale_tag_2", "label": "Sale option 2 tag" },
    { "type": "number", "id": "sale_price_3", "label": "Sale option 3 total ($)" },
    { "type": "text", "id": "sale_tag_3", "label": "Sale option 3 tag" },
    { "type": "text", "id": "sale_note", "label": "Sale note under options" }
  ],
  "presets": [{ "name": "Everden bundles" }]
}
{% endschema %}
