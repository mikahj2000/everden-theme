    "ks_faq": {
      "type": "everden-faq",
      "blocks": {
        "q_nonstick": {
          "type": "faq",
          "settings": {
            "question": "Can I use them on nonstick pans?",
            "answer": "<p>Yes. Teak is gentle on nonstick and enameled cookware.</p>"
          }
        },
        "q_dish": {
          "type": "faq",
          "settings": {
            "question": "Can they go in the dishwasher?",
            "answer": "<p>No. Wash them by hand in warm, soapy water, rinse, and stand them handle-down in their cup to dry.</p>"
          }
        },
        "q_stain": {
          "type": "faq",
          "settings": {
            "question": "Will they stain?",
            "answer": "<p>Strongly colored foods like turmeric or tomato sauce can tint the wood a little over time. Washing them soon after cooking helps.</p>"
          }
        },
        "q_store": {
          "type": "faq",
          "settings": {
            "question": "How should I store them?",
            "answer": "<p>Keep them standing in their cup by the stove, or hang them: every handle has a hanging hole.</p>"
          }
        },
        "q_cup": {
          "type": "faq",
          "settings": {
            "question": "Is the cup teak too?",
            "answer": "<p>No. The utensil cup is solid jujube wood, 3.5 in wide and 5.1 in tall.</p>"
          }
        },
