        "why": {
          "type": "split",
          "settings": {
            "image": "shopify://shop_images/everden-kitchen-set-stove.jpg",
            "reverse": false,
            "background": "ivory",
            "label": "Why teak",
            "heading": "No plastic to shed into your food.",
            "text": "<p>Plastic cutting boards shed microplastics as you cut. Our teak utensils have no plastic to shed, and they won't melt or flake on a hot pan.</p>",
            "points": "No plastic to shed\nWon't melt or flake\nSafe on nonstick and enamel\nStays cool to hold",
            "note": "Plastic boards shed microplastics as you cut – Yadav et al., Environmental Science & Technology, 2023."
          }
        },
        "cards": {
          "type": "cards",
          "settings": {
            "background": "paper",
            "label": "In the box",
            "heading": "Everything you reach for at the stove.",
            "text": "",
            "image1": "shopify://shop_images/everden-kitchen-set-seven.jpg",
            "title1": "Seven teak utensils",
            "body1": "Ladle, cooking spoon, slotted spoon, spatula, turner, slotted turner and pasta server.",
            "image2": "shopify://shop_images/everden-kitchen-set-stove.jpg",
            "title2": "A solid jujube wood cup",
            "body2": "Keeps all seven standing close at hand. 3.5 in wide and 5.1 in tall.",
            "image3": "shopify://shop_images/everden-kitchen-set-pasta.jpg",
            "title3": "Bamboo dish brush",
            "body3": "Round, with natural bristles, on its own white ceramic dish.",
            "image4": "shopify://shop_images/everden-kitchen-set-sizes-v2.jpg",
            "title4": "Sized for every job",
            "body4": "From the 10.2 in cooking spoon to the 13.4 in turner."
          }
        },
        "stats": {
