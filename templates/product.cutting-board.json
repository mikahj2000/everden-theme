        "material": {
          "type": "split",
          "settings": {
            "image": "shopify://shop_images/everden-cutting-board-sizes.jpg",
            "reverse": true,
            "background": "paper",
            "label": "The material",
            "heading": "Teak, chosen for the way it ages.",
            "text": "<p>For centuries teak has been the wood of ships' decks and garden furniture, trusted where water and weather are hard on wood. In the kitchen, those same qualities suit boards and tools you use every day.</p>",
            "points": "Rich in its own oils, which help the wood resist moisture.\nTight and stable, so it holds its shape with simple care.\nCut from real timber. The grain on your piece is yours alone.",
            "note": ""
          }
        },
        "compare": {
          "type": "compare",
          "settings": {}
        },
        "care": {
          "type": "steps",
          "settings": {
            "background": "stone",
            "label": "Care routine",
            "heading": "A few minutes of care, once a month.",
            "text": "Three simple habits keep your teak looking its best.",
            "show_guide": true,
            "step_title1": "Wash by hand",
            "step_text1": "Warm water and a little mild soap, straight after use.",
            "step_when1": "After every use",
            "step_title2": "Dry upright",
            "step_text2": "Towel it dry and stand it on its edge, so air reaches every side.",
            "step_when2": "After every use",
            "step_title3": "Oil each month",
            "step_text3": "Work in food-grade mineral oil or fractionated coconut oil, leave it overnight, then buff away the excess.",
            "step_when3": "Once a month",
            "upsell_product": "the-kitchen-collection",
            "upsell_label": "Complete the kitchen",
            "upsell_text": "Every Everden piece in one set: our three-board trio, the counter-lip board and the complete set of teak cooking tools.",
            "upsell_sub": "$517 bought separately",
            "upsell_button": "View the collection"
          }
        },
        "guarantee": {
          "type": "guarantee",
          "settings": {
            "background": "paper",
            "days": "30",
            "label": "Our promise",
            "heading": "30-day money-back guarantee",
            "text": "<p>Every order ships tracked. If a piece isn't right for your home, tell us within 30 days of delivery for a full refund.</p><p>Questions before you order? We're real people and we're happy to help.</p>",
            "button_label": "Back to top"
          }
        },
        "faq": {
          "type": "faq",
          "settings": {
            "background": "ivory",
            "label": "Questions",
            "heading": "Before you order",
            "q1": "Can I send it as a gift?",
            "a1": "Yes. Just enter their name and address at checkout and we'll ship it straight to them. For Christmas delivery, please order by December 5.",
            "q2": "Will my piece look exactly like the photos?",
            "a2": "Not exactly. Every piece is cut from real teak, so the grain, colour and small markings on yours will be unique.",
            "q3": "Can it go in the dishwasher?",
            "a3": "No. The heat and long soak can dry out and crack the wood. Hand wash with warm, soapy water, dry it straight away, and oil it about once a month.",
            "q4": "Why does it feel slightly oily?",
            "a4": "That's teak's own natural oil, and it's part of what helps the wood resist moisture. It's normal and settles down with use.",
            "q5": "How do I get rid of smells or stains?",
            "a5": "Sprinkle on coarse salt, scrub with half a lemon, rinse, dry, then add a little food-grade mineral oil.",
            "q6": "When will my order arrive?",
            "a6": "Orders ship with tracking and usually arrive within 7–12 business days.",
            "q7": "What if it's not for me?",
            "a7": "You're covered by our 30-day money-back guarantee. Email us within 30 days of delivery and we'll refund you in full."
          }
        }
