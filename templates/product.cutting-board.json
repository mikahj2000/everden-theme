          "settings": {
            "image": "shopify://shop_images/everden-cutting-board-serving.jpg",
            "reverse": false,
            "background": "ivory",
            "label": "Why teak",
            "heading": "No plastic to shed into your food.",
            "text": "<p>Plastic cutting boards shed microplastics as you cut. Solid teak has no plastic to shed, and it won't melt or flake.</p>",
            "points": "No plastic to shed\nRich in natural oils that help it resist moisture\nHand wash, dry upright, oil monthly",
            "note": "Plastic boards shed microplastics as you cut – Yadav et al., Environmental Science & Technology, 2023."
          }
        },
        "cards": {
          "type": "cards",
          "settings": {
            "background": "paper",
            "label": "The details",
            "heading": "Made for the way you cook.",
            "text": "",
            "image1": "shopify://shop_images/everden-cutting-board-sizes.jpg",
            "title1": "Counter lip and side handle",
            "body1": "The lip hooks over your worktop edge so the board stays put, and the recessed handle makes it easy to carry, even when it's full.",
            "image2": "shopify://shop_images/everden-cutting-board-serving.jpg",
            "title2": "Deep juice groove",
            "body2": "Runs around the edge, with a corner well that catches juices from a roast or ripe fruit."
          }
        },
        "stats": {
