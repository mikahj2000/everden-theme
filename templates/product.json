    "everden_story": {
      "type": "everden-pdp",
      "blocks": {
        "faq1": {
          "type": "faq",
          "settings": {
            "question": "How long is a session?",
            "answer": "15 minutes. Most people pick one time a day that's easy to stick to, like after coffee, after work or before bed."
          }
        },
        "faq2": {
          "type": "faq",
          "settings": {
            "question": "Will it fit my knee?",
            "answer": "The wrap fastens with an adjustable hook-and-loop strap. If you're not sure it will fit, measure around your knee and message us before you order."
          }
        },
        "faq3": {
          "type": "faq",
          "settings": {
            "question": "What does it feel like?",
            "answer": "A soft red glow, gentle warmth and a light vibration. Start on the lowest heat and massage levels, then adjust to what feels comfortable."
          }
        },
        "faq9": {
          "type": "faq",
          "settings": {
            "question": "Does it get hot?",
            "answer": "It has 3 heat levels: 113°F, 122°F and 131°F. Start on the lowest level and check your skin. If it ever feels too hot, turn the heat down or off. It switches off on its own after 30 minutes."
          }
        },
        "faq4": {
          "type": "faq",
          "settings": {
            "question": "How soon will I notice anything?",
            "answer": "Everyone is different. Think of it as a daily routine, not a quick fix, and give it a few weeks of regular use."
          }
        },
        "faq5": {
          "type": "faq",
          "settings": {
            "question": "Who shouldn't use it?",
            "answer": "Check with your doctor first if you're pregnant, take medication that makes your skin sensitive to light, have reduced feeling in your legs (for example from diabetes or nerve damage), have a skin condition or an injury at the area, or have any medical concerns. Don't use it over broken skin, don't fall asleep with the heat on, and don't look directly into the lights."
          }
        },
        "faq6": {
          "type": "faq",
          "settings": {
            "question": "Is it a medical device?",
            "answer": "No. Everden is a wellness and recovery product. It isn't intended to diagnose, treat, cure or prevent any disease."
          }
        },
        "faq7": {
          "type": "faq",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "Orders ship with tracking and usually arrive within 5–7 business days."
          }
        },
        "faq8": {
          "type": "faq",
          "settings": {
            "question": "What if it's not for me?",
            "answer": "You're covered by our 30-day money-back guarantee. Email us within 30 days of delivery and we'll refund you in full."
          }
        }
      },
