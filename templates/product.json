    "everden_teak_story": {
      "type": "everden-teak-story",
      "blocks": {
        "faq1": {
          "type": "faq",
          "settings": {
            "question": "Will my piece look exactly like the photos?",
            "answer": "Not exactly. Every piece is cut from real teak, so the grain, colour and small markings on yours will be unique."
          }
        },
        "faq2": {
          "type": "faq",
          "settings": {
            "question": "Can it go in the dishwasher?",
            "answer": "No. The heat and long soak can dry out and crack the wood. Hand wash with warm, soapy water, dry it straight away, and oil it about once a month."
          }
        },
        "faq3": {
          "type": "faq",
          "settings": {
            "question": "Why does it feel slightly oily?",
            "answer": "That's teak's own natural oil, and it's part of what helps the wood resist moisture. It's normal and settles down with use."
          }
        },
        "faq4": {
          "type": "faq",
          "settings": {
            "question": "How do I get rid of smells or stains?",
            "answer": "Sprinkle on coarse salt, scrub with half a lemon, rinse, dry, then add a little food-grade mineral oil."
          }
        },
        "faq5": {
          "type": "faq",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "Orders ship with tracking and usually arrive within 7–12 business days."
          }
        },
        "faq6": {
          "type": "faq",
          "settings": {
            "question": "What if it's not for me?",
            "answer": "You're covered by our 30-day money-back guarantee. Email us within 30 days of delivery and we'll refund you in full."
          }
        },
        "faq_gift": {
          "type": "faq",
          "settings": {
            "question": "Can I send it as a gift?",
            "answer": "Yes. Just enter their name and address at checkout and we'll ship it straight to them. For Christmas delivery, please order by December 5."
          }
        }
      },
