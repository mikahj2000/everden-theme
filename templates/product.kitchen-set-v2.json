    "ks_research": {
      "type": "everden-research",
      "settings": {
        "label": "Why it matters",
        "heading": "What the research shows",
        "intro": "Your utensils sit against a hot pan every night. Here's what two studies found about plastic in the kitchen, with links so you can read them yourself.",
        "note": "Neither study shows these particles or compounds harm your health. Researchers say that's still being worked out. We share them so you can decide for yourself."
